<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="TerrainAndRoverUI.uss" />

    <!-- Compact Floating Pill when Studio is completely minimized -->
    <ui:Button name="BtnFloatingDock" text="VR ROVER STUDIO [Tab]" class="floating-dock-btn hud-interactive" style="display: none;" />

    <ui:VisualElement name="StudioRoot" class="studio-root">
        <!-- Slim Placement Mode Banner -->
        <ui:VisualElement name="PlacementBanner" class="placement-banner hud-interactive" style="display: none;">
            <ui:Label name="LblPlacementBannerText" text="Click terrain to place rover · [Q,E] or Scroll to Rotate · [Esc] Cancel" class="placement-banner-text" />
            <ui:Button name="BtnPlacementQuickCentre" text="QUICK SPAWN (CENTRE)" class="placement-banner-btn" tooltip="Spawn directly at the center of the terrain" />
            <ui:Button name="BtnPlacementCancel" text="CANCEL [Esc]" class="placement-banner-btn btn-cancel" tooltip="Cancel placement and return to studio" />
        </ui:VisualElement>

        <!-- Top Header Bar -->
        <ui:VisualElement class="studio-header hud-interactive">
            <ui:VisualElement class="header-left">
                <ui:VisualElement class="studio-logo-icon" />
                <ui:Label text="VR ROVER DIGITAL TWIN STUDIO" class="studio-title" />
            </ui:VisualElement>

            <!-- Mode Switch: Driving HUD vs Full Studio -->
            <ui:VisualElement class="header-center">
                <ui:Button name="BtnModeDriving" text="DRIVING HUD" class="view-switch-pill" tooltip="Unobstructed 3D view for driving [Tab]" />
                <ui:Button name="BtnModeStudio" text="FULL STUDIO" class="view-switch-pill view-switch-active" tooltip="Full mission control dashboard [Tab]" />
            </ui:VisualElement>

            <ui:VisualElement class="header-right">
                <ui:Label name="BadgeStatus" text="● ACTIVE" class="header-pill pill-active" />
                <ui:Button name="BtnPlanetBadge" text="MARS" class="header-pill pill-planet" tooltip="Click to open Planet Selection [P]" />
                <ui:Label name="BadgeDriveMode" text="SKID-STEER 4WD" class="header-pill pill-mode" />
                <ui:Button name="BtnMinimizeStudio" text="—" class="window-minimize-btn" tooltip="Minimize to floating dock [U]" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Main 3-Column Studio Grid -->
        <ui:VisualElement name="StudioMainGrid" class="studio-main-grid">
            <!-- COLUMN 1 (Left): Kinematics, Attitude, Position -->
            <ui:VisualElement name="ColLeft" class="studio-col col-left hud-interactive">
                <!-- Kinematics Card -->
                <ui:VisualElement class="studio-card">
                    <ui:VisualElement class="card-header">
                        <ui:Label text="KINEMATICS / SPEED" class="card-title" tooltip="Truthful rigid-body and wheel motion telemetry" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat-grid-2x2">
                        <ui:VisualElement class="stat-cell" tooltip="Linear velocity magnitude of rover chassis">
                            <ui:Label text="SPEED (LINEAR)" class="stat-label" />
                            <ui:VisualElement class="val-unit-row">
                                <ui:Label name="ValLinearSpeed" text="0.00" class="stat-big-val" />
                                <ui:Label text="m/s" class="stat-unit" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-cell" tooltip="Ground vehicle speed in kilometers per hour">
                            <ui:Label text="SPEED (GROUND)" class="stat-label" />
                            <ui:VisualElement class="val-unit-row">
                                <ui:Label name="ValGroundSpeed" text="0.00" class="stat-big-val" />
                                <ui:Label text="km/h" class="stat-unit" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-cell" tooltip="Forward acceleration in m/s²">
                            <ui:Label text="ACCELERATION" class="stat-label" />
                            <ui:VisualElement class="val-unit-row">
                                <ui:Label name="ValAcceleration" text="+0.00" class="stat-med-val val-green" />
                                <ui:Label text="m/s²" class="stat-unit" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-cell" tooltip="Normalized inertial g-force load">
                            <ui:Label text="G-FORCE" class="stat-label" />
                            <ui:VisualElement class="val-unit-row">
                                <ui:Label name="ValGForce" text="1.00" class="stat-med-val" />
                                <ui:Label text="G" class="stat-unit" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Attitude & Orientation Card -->
                <ui:VisualElement class="studio-card">
                    <ui:VisualElement class="card-header">
                        <ui:Label text="ATTITUDE &amp; ORIENTATION" class="card-title" tooltip="Orientation, pitch, roll, and cardinal compass heading" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat-grid-2x2">
                        <ui:VisualElement class="stat-cell" tooltip="Chassis pitch angle in degrees relative to horizontal plane">
                            <ui:Label text="PITCH" class="stat-label" />
                            <ui:Label name="ValPitch" text="0.0°" class="stat-med-val" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-cell" tooltip="Chassis roll angle in degrees relative to horizontal plane">
                            <ui:Label text="ROLL" class="stat-label" />
                            <ui:Label name="ValRoll" text="0.0°" class="stat-med-val" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-cell" tooltip="Compass bearing and cardinal direction">
                            <ui:Label text="HEADING" class="stat-label" />
                            <ui:Label name="ValHeading" text="000° N" class="stat-med-val val-cyan" />
                            <ui:VisualElement class="heading-sub-row">
                                <ui:VisualElement class="heading-bar-bg">
                                    <ui:VisualElement name="BarHeadingLevel" class="heading-bar-fill" style="width: 50%;" />
                                </ui:VisualElement>
                                <ui:Label name="IconAttitudeWarning" text="▲" class="attitude-warn-icon" style="display: none;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-cell" tooltip="Terrain surface gradient slope under the rover in degrees">
                            <ui:Label text="SLOPE" class="stat-label" />
                            <ui:Label name="ValSlope" text="0.0°" class="stat-med-val" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Position & Odometry Card -->
                <ui:VisualElement name="CardPosition" class="studio-card">
                    <ui:VisualElement class="card-header">
                        <ui:Label text="POSITION &amp; ODOMETRY" class="card-title" tooltip="Spatial coordinates and traverse distance metrics" />
                    </ui:VisualElement>
                    <ui:Label text="WORLD COORDINATES (XYZ)" class="stat-label" />
                    <ui:Label name="ValCoords" text="X 0.00 m   Y 0.00 m   Z 0.00 m" class="stat-coords-val" />
                    <ui:VisualElement class="stat-grid-2x1" style="margin-top: 6px;">
                        <ui:VisualElement class="stat-cell">
                            <ui:Label text="DISTANCE TRAVELED" class="stat-label" />
                            <ui:Label name="ValOdometer" text="0.00 m" class="stat-med-val" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-cell">
                            <ui:Label text="MISSION TIME" class="stat-label" />
                            <ui:Label name="ValMissionTime" text="00:00:00" class="stat-med-val" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- COLUMN 2 (Center): Terrain Overview + Deploy Rover + Terrain Lab Workbench -->
            <ui:VisualElement name="ColCenter" class="studio-col col-center hud-interactive">
                <!-- Studio Tab Bar: Mission Radar vs Terrain Lab -->
                <ui:VisualElement class="studio-tab-bar">
                    <ui:Button name="BtnTabMission" text="MISSION RADAR" class="studio-tab-btn studio-tab-btn-active" tooltip="Topographic radar &amp; rover deployment" />
                    <ui:Button name="BtnTabTerrainLab" text="TERRAIN LAB" class="studio-tab-btn" tooltip="Interactive 2D heightmap painter, spatial tuning &amp; materials" />
                </ui:VisualElement>

                <!-- TAB 1: Mission Radar & Deploy Rover -->
                <ui:VisualElement name="TabMissionView" class="tab-view-container">
                    <!-- Terrain Overview & Radar Card -->
                    <ui:VisualElement class="studio-card center-radar-card">
                        <ui:VisualElement class="card-header" style="width: 100%;">
                            <ui:Label text="TERRAIN OVERVIEW" class="card-title" />
                            <ui:Button name="BtnBrowseFile" text="Upload Image..." class="card-mini-btn" />
                        </ui:VisualElement>

                        <!-- Topographic Minimap Container (Click to place / teleport) -->
                        <ui:VisualElement name="MinimapContainer" class="minimap-container" tooltip="Click on minimap to teleport or place active rover at coordinates">
                            <ui:Image name="HeightmapPreviewImage" class="minimap-elevation-image" />
                            <ui:VisualElement class="minimap-grid-overlay" />
                            <ui:VisualElement name="MinimapBreadcrumbsContainer" class="minimap-breadcrumbs-container" />
                            <ui:VisualElement name="RadarRoverDot" class="radar-rover-dot">
                                <ui:VisualElement name="RadarRoverHeadingArrow" class="radar-rover-arrow" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="radar-legend-row">
                            <ui:Label text="● ROVER POSE" class="radar-legend-tag" tooltip="Live rover position and directional heading" />
                            <ui:Label name="LabelRadarRange" text="GRID 1000m × 1000m" class="radar-range-tag" tooltip="Real-world planetary terrain dimensions" />
                        </ui:VisualElement>

                        <!-- Planetary Presets Row -->
                        <ui:VisualElement class="center-presets-row">
                            <ui:Button name="BtnPresetGale" text="Gale Crater" class="studio-preset-pill preset-active" tooltip="Gale Crater: central mound surrounded by plains" />
                            <ui:Button name="BtnPresetOlympus" text="Olympus Mons" class="studio-preset-pill" tooltip="Olympus Mons: massive volcanic caldera shield" />
                            <ui:Button name="BtnPresetShackleton" text="Shackleton" class="studio-preset-pill" tooltip="Shackleton Crater: deep impact crater with shadowed basin" />
                            <ui:Button name="BtnPresetValles" text="Valles" class="studio-preset-pill" tooltip="Valles Marineris: dramatic tectonic chasm canyon" />
                            <ui:Button name="BtnPresetFractal" text="Plains" class="studio-preset-pill" tooltip="Rolling terrain with multi-frequency procedural noise" />
                        </ui:VisualElement>

                        <!-- Primary Generate Terrain Action -->
                        <ui:Button name="BtnGenerateTerrain" text="GENERATE NEW PLANETARY TERRAIN" class="studio-generate-btn" tooltip="Generate fresh heightmap, rebuild terrain geometry, sync colliders, and relocate rover" />
                    </ui:VisualElement>

                    <!-- Deploy Digital Twin Rover Card -->
                    <ui:VisualElement class="studio-card deploy-card">
                        <ui:VisualElement class="card-header">
                            <ui:Label text="DEPLOY DIGITAL TWIN ROVER" class="card-title" tooltip="Select active robotics platform or place at cursor" />
                        </ui:VisualElement>

                        <!-- Empty State Banner when no rover is active -->
                        <ui:VisualElement name="RoverEmptyStateBanner" class="rover-empty-state-banner" style="display: none;">
                            <ui:Label text="⚠️ STANDBY: Select a rover below, then click terrain or Quick Spawn" class="empty-state-text" />
                        </ui:VisualElement>

                        <ui:VisualElement class="rover-list">
                            <ui:Button name="BtnRoverHusky" class="rover-item-row rover-active-row" tooltip="Clearpath Husky A200: Skid-steer 4WD rugged mobile platform (50 kg)">
                                <ui:VisualElement class="rover-name-row">
                                    <ui:Label text="Clearpath Husky A200" class="rover-item-name" />
                                </ui:VisualElement>
                                <ui:Label name="TagHuskyActive" text="ACTIVE" class="rover-active-tag" />
                            </ui:Button>

                            <ui:Button name="BtnRoverM20" class="rover-item-row" tooltip="Deep Robotics M20: Quadruped autonomous exploration robot (45 kg)">
                                <ui:VisualElement class="rover-name-row">
                                    <ui:Label text="Deep Robotics M20" class="rover-item-name" />
                                </ui:VisualElement>
                                <ui:Label name="TagM20Active" text="DEPLOY" class="rover-idle-tag" />
                            </ui:Button>

                            <ui:Button name="BtnRoverM2020" class="rover-item-row" tooltip="NASA Perseverance Mars 2020: 6WD Rocker-Bogie astrobiology science rover (1025 kg)">
                                <ui:VisualElement class="rover-name-row">
                                    <ui:Label text="NASA Perseverance M2020" class="rover-item-name" />
                                </ui:VisualElement>
                                <ui:Label name="TagM2020Active" text="DEPLOY" class="rover-idle-tag" />
                            </ui:Button>
                        </ui:VisualElement>
                        <ui:Button name="BtnQuickSpawnCentre" text="QUICK SPAWN AT CENTRE" class="card-mini-btn" style="margin-top: 6px; width: 100%; height: 26px;" tooltip="Spawn the selected rover directly at terrain centre" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- TAB 2: Terrain Lab Workbench -->
                <ui:ScrollView name="TabTerrainLabView" class="terrain-lab-scroll" style="display: none;">
                    <!-- 1. Presets & File Operations -->
                    <ui:VisualElement class="studio-card" style="margin-bottom: 6px;">
                        <ui:VisualElement class="card-header">
                            <ui:Label text="PRESETS &amp; PNG I/O" class="card-title" />
                        </ui:VisualElement>
                        <ui:VisualElement class="preset-grid-lab">
                            <ui:Button name="BtnLabPresetGale" text="Gale Crater" class="preset-btn-lab preset-btn-lab-active" />
                            <ui:Button name="BtnLabPresetOlympus" text="Olympus" class="preset-btn-lab" />
                            <ui:Button name="BtnLabPresetShackleton" text="Shackleton" class="preset-btn-lab" />
                            <ui:Button name="BtnLabPresetValles" text="Valles" class="preset-btn-lab" />
                            <ui:Button name="BtnLabPresetPlains" text="Plains" class="preset-btn-lab" />
                            <ui:Button name="BtnLabPresetFractal" text="Fractal" class="preset-btn-lab" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between; margin-top: 2px;">
                            <ui:Label text="Seed:" class="param-name" style="font-size: 8px;" />
                            <ui:IntegerField name="FieldSeed" value="0" style="width: 70px; height: 18px; font-size: 8px;" />
                            <ui:Button name="BtnRandomSeed" text="🎲 Random" class="card-mini-btn" style="height: 18px; font-size: 8px;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="file-ops-row">
                            <ui:Button name="BtnImportPNG" text="📁 Import PNG..." class="file-op-btn" tooltip="Import 8-bit or 16-bit grayscale heightmap image" />
                            <ui:Button name="BtnExportPNG" text="💾 Export PNG..." class="file-op-btn" tooltip="Export current heightmap to grayscale PNG" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 2. Interactive 2D Heightmap Canvas Painter -->
                    <ui:VisualElement class="studio-card" style="margin-bottom: 6px;">
                        <ui:VisualElement class="card-header">
                            <ui:Label text="2D HEIGHTMAP PAINTER" class="card-title" />
                        </ui:VisualElement>
                        <ui:VisualElement class="painter-canvas-wrapper">
                            <ui:Image name="HeightmapPainterImage" class="painter-canvas-image" />
                            <ui:Label text="LMB: paint · [Ctrl+Z] Undo · [Ctrl+Y] Redo" class="canvas-hint" />
                        </ui:VisualElement>
                        <!-- Brush Mode Selection Bar -->
                        <ui:VisualElement class="brush-bar">
                            <ui:Button name="BtnBrushRaise" text="▲ Raise" class="brush-btn brush-btn-active" tooltip="Raise elevation" />
                            <ui:Button name="BtnBrushLower" text="▼ Lower" class="brush-btn" tooltip="Lower elevation" />
                            <ui:Button name="BtnBrushSmooth" text="≈ Smooth" class="brush-btn" tooltip="Smooth terrain" />
                            <ui:Button name="BtnBrushFlatten" text="━ Flat" class="brush-btn" tooltip="Flatten to target height" />
                            <ui:Button name="BtnBrushNoise" text="⚡ Noise" class="brush-btn" tooltip="Add surface noise perturbation" />
                        </ui:VisualElement>
                        <!-- History Bar: Undo, Redo, Counter -->
                        <ui:VisualElement class="history-bar">
                            <ui:Button name="BtnUndo" text="↶ Undo" class="history-btn" />
                            <ui:Label name="LabelHistoryStatus" text="History: 0/20" class="history-lbl" />
                            <ui:Button name="BtnRedo" text="↷ Redo" class="history-btn" />
                        </ui:VisualElement>
                        <!-- Brush Sliders -->
                        <ui:VisualElement class="slider-row">
                            <ui:VisualElement class="slider-label-row">
                                <ui:Label text="Brush Radius:" class="param-name" style="font-size: 8px;" />
                                <ui:Label name="LabelBrushRadiusVal" text="8%" class="param-val" style="font-size: 8px;" />
                            </ui:VisualElement>
                            <ui:Slider name="SliderBrushRadius" low-value="0.01" high-value="0.25" value="0.08" />
                        </ui:VisualElement>
                        <ui:VisualElement class="slider-row">
                            <ui:VisualElement class="slider-label-row">
                                <ui:Label text="Brush Strength:" class="param-name" style="font-size: 8px;" />
                                <ui:Label name="LabelBrushStrengthVal" text="40%" class="param-val" style="font-size: 8px;" />
                            </ui:VisualElement>
                            <ui:Slider name="SliderBrushStrength" low-value="0.05" high-value="1.0" value="0.4" />
                        </ui:VisualElement>
                        <ui:VisualElement class="slider-row">
                            <ui:VisualElement class="slider-label-row">
                                <ui:Label text="Hardness (Falloff):" class="param-name" style="font-size: 8px;" />
                                <ui:Label name="LabelBrushHardnessVal" text="50%" class="param-val" style="font-size: 8px;" />
                            </ui:VisualElement>
                            <ui:Slider name="SliderBrushHardness" low-value="0.0" high-value="1.0" value="0.5" />
                        </ui:VisualElement>
                        <ui:VisualElement name="RowFlattenHeight" class="slider-row" style="display: none;">
                            <ui:VisualElement class="slider-label-row">
                                <ui:Label text="Target Flatten Height:" class="param-name" style="font-size: 8px;" />
                                <ui:Label name="LabelFlattenHeightVal" text="50%" class="param-val" style="font-size: 8px;" />
                            </ui:VisualElement>
                            <ui:Slider name="SliderFlattenHeight" low-value="0.0" high-value="1.0" value="0.5" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 3. Elevation & Spatial Tuning -->
                    <ui:VisualElement class="studio-card" style="margin-bottom: 6px;">
                        <ui:VisualElement class="card-header">
                            <ui:Label text="ELEVATION &amp; SPATIAL TUNING" class="card-title" />
                        </ui:VisualElement>
                        <!-- Elevation Scale -->
                        <ui:VisualElement class="slider-row">
                            <ui:VisualElement class="slider-label-row">
                                <ui:Label text="Elevation Scale (Amplitude):" class="param-name" style="font-size: 8px;" />
                                <ui:Label name="LabelMaxHeightVal" text="120 m" class="param-val" style="font-size: 8px;" />
                            </ui:VisualElement>
                            <ui:Slider name="SliderMaxHeight" low-value="5" high-value="500" value="120" />
                        </ui:VisualElement>
                        <!-- Base Floor Offset -->
                        <ui:VisualElement class="slider-row">
                            <ui:VisualElement class="slider-label-row">
                                <ui:Label text="Base Elevation Offset:" class="param-name" style="font-size: 8px;" />
                                <ui:Label name="LabelBaseOffsetVal" text="0 m" class="param-val" style="font-size: 8px;" />
                            </ui:VisualElement>
                            <ui:Slider name="SliderBaseOffset" low-value="-50" high-value="50" value="0" />
                        </ui:VisualElement>
                        <!-- Terrain Bounds -->
                        <ui:VisualElement class="slider-row">
                            <ui:VisualElement class="slider-label-row">
                                <ui:Label text="Terrain Size (Width x Length):" class="param-name" style="font-size: 8px;" />
                                <ui:Label name="LabelTerrainSizeVal" text="1000 x 1000 m" class="param-val" style="font-size: 8px;" />
                            </ui:VisualElement>
                            <ui:Slider name="SliderTerrainSize" low-value="200" high-value="2000" value="1000" />
                        </ui:VisualElement>
                        <!-- Resolution Dropdown (257, 513, 1025, 2049 only) -->
                        <ui:DropdownField name="DropdownResolution" label="Heightmap Res" choices="257 x 257 (High Detail),513 x 513 (Very High),1025 x 1025 (Ultra Detail),2049 x 2049 (Extreme)" value="513 x 513 (Very High)" style="font-size: 8px; margin-bottom: 4px;" />
                        <!-- Gaussian Smoothing -->
                        <ui:VisualElement class="slider-row">
                            <ui:VisualElement class="slider-label-row">
                                <ui:Label text="Anti-Staircase Smoothing:" class="param-name" style="font-size: 8px;" />
                                <ui:Label name="LabelSmoothingVal" text="1.0" class="param-val" style="font-size: 8px;" />
                            </ui:VisualElement>
                            <ui:Slider name="SliderSmoothing" low-value="0" high-value="5" value="1" />
                        </ui:VisualElement>
                        <!-- Height Remapping Curve -->
                        <ui:Label text="Height Remap Curve:" class="param-name" style="font-size: 8px; margin-top: 2px;" />
                        <ui:VisualElement class="curve-bar">
                            <ui:Button name="BtnCurveLinear" text="Linear" class="curve-btn curve-btn-active" />
                            <ui:Button name="BtnCurveExponential" text="Exp" class="curve-btn" />
                            <ui:Button name="BtnCurveRidge" text="Ridge" class="curve-btn" />
                            <ui:Button name="BtnCurveBasin" text="Basin" class="curve-btn" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 4. Planetary Surface Material -->
                    <ui:VisualElement class="studio-card" style="margin-bottom: 6px;">
                        <ui:VisualElement class="card-header">
                            <ui:Label text="PLANETARY SURFACE MATERIAL" class="card-title" />
                        </ui:VisualElement>
                        <ui:Toggle name="ToggleFollowPlanet" label="Follow Planet Profile (Default)" value="true" class="lab-toggle" />
                        <ui:VisualElement class="material-grid">
                            <ui:Button name="BtnMatMartian" text="🔴 Martian Rust Oxide" class="material-btn material-btn-active" />
                            <ui:Button name="BtnMatLunar" text="⚪ Lunar Regolith" class="material-btn" />
                            <ui:Button name="BtnMatBasalt" text="⚫ Volcanic Basalt" class="material-btn" />
                            <ui:Button name="BtnMatIce" text="❄️ Polar Cryo-Ice Cap" class="material-btn" />
                            <ui:Button name="BtnMatCanyon" text="🟤 Red Sandstone" class="material-btn" />
                            <ui:Button name="BtnMatWireframe" text="🟩 Topographic Grid" class="material-btn" />
                            <ui:Button name="BtnMatNormal" text="🟣 Normal Inspector" class="material-btn" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 5. Apply & Live Preview -->
                    <ui:VisualElement class="studio-card" style="margin-bottom: 4px;">
                        <ui:Toggle name="ToggleLivePreview" label="Live Preview on 3D Terrain" value="false" class="lab-toggle" />
                        <ui:Button name="BtnApplyTerrainLab" text="✨ APPLY TUNING &amp; REBUILD TERRAIN" class="studio-generate-btn" />
                        <ui:Label text="Syncs TerrainCollider &amp; auto-respawns active rover" class="canvas-hint" style="-unity-text-align: middle-center; margin-top: 3px;" />
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- COLUMN 3 (Right): Actuators, Power/Thermal, Planetary Environment -->
            <ui:VisualElement name="ColRight" class="studio-col col-right hud-interactive">
                <!-- Actuators / Wheel Traction Card -->
                <ui:VisualElement class="studio-card actuators-card">
                    <ui:VisualElement class="card-header">
                        <ui:Label text="ACTUATORS / WHEEL TRACTION" class="card-title" tooltip="Individual wheel drive status, rotational velocity, and dynamic slip" />
                    </ui:VisualElement>
                    <ui:VisualElement name="WheelContainer" class="wheel-grid-2x2">
                        <!-- FL -->
                        <ui:VisualElement class="wheel-cell" tooltip="Front-Left wheel traction &amp; ground contact">
                            <ui:VisualElement class="wheel-info-col">
                                <ui:Label text="FL" class="wheel-name" />
                                <ui:Label name="TagWheelFL" text="GOOD" class="wheel-status tag-good" />
                            </ui:VisualElement>
                            <ui:VisualElement name="SegsWheelFL" class="wheel-segments-row">
                                <ui:VisualElement class="wheel-seg seg-active" />
                                <ui:VisualElement class="wheel-seg seg-active" />
                                <ui:VisualElement class="wheel-seg seg-active" />
                                <ui:VisualElement class="wheel-seg seg-active" />
                                <ui:VisualElement class="wheel-seg seg-active" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- FR -->
                        <ui:VisualElement class="wheel-cell" tooltip="Front-Right wheel traction &amp; ground contact">
                            <ui:VisualElement class="wheel-info-col">
                                <ui:Label text="FR" class="wheel-name" />
                                <ui:Label name="TagWheelFR" text="GOOD" class="wheel-status tag-good" />
                            </ui:VisualElement>
                            <ui:VisualElement name="SegsWheelFR" class="wheel-segments-row">
                                <ui:VisualElement class="wheel-seg seg-active" />
                                <ui:VisualElement class="wheel-seg seg-active" />
                                <ui:VisualElement class="wheel-seg seg-active" />
                                <ui:VisualElement class="wheel-seg seg-active" />
                                <ui:VisualElement class="wheel-seg seg-active" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- RL -->
                        <ui:VisualElement class="wheel-cell" tooltip="Rear-Left wheel traction &amp; ground contact">
                            <ui:VisualElement class="wheel-info-col">
                                <ui:Label text="RL" class="wheel-name" />
                                <ui:Label name="TagWheelRL" text="GOOD" class="wheel-status tag-good" />
                            </ui:VisualElement>
                            <ui:VisualElement name="SegsWheelRL" class="wheel-segments-row">
                                <ui:VisualElement class="wheel-seg seg-active" />
                                <ui:VisualElement class="wheel-seg seg-active" />
                                <ui:VisualElement class="wheel-seg seg-active" />
                                <ui:VisualElement class="wheel-seg seg-active" />
                                <ui:VisualElement class="wheel-seg seg-active" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- RR -->
                        <ui:VisualElement class="wheel-cell" tooltip="Rear-Right wheel traction &amp; ground contact">
                            <ui:VisualElement class="wheel-info-col">
                                <ui:Label text="RR" class="wheel-name" />
                                <ui:Label name="TagWheelRR" text="FAIR" class="wheel-status tag-fair" />
                            </ui:VisualElement>
                            <ui:VisualElement name="SegsWheelRR" class="wheel-segments-row">
                                <ui:VisualElement class="wheel-seg seg-active" />
                                <ui:VisualElement class="wheel-seg seg-active" />
                                <ui:VisualElement class="wheel-seg seg-active" />
                                <ui:VisualElement class="wheel-seg seg-active" />
                                <ui:VisualElement class="wheel-seg seg-inactive" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Power & Thermal Card (Lumped physics-derived estimate) -->
                <ui:VisualElement class="studio-card power-card">
                    <ui:VisualElement class="card-header">
                        <ui:Label text="POWER &amp; THERMAL" class="card-title" tooltip="Truthful energy budget and thermal dynamics (EST)" />
                    </ui:VisualElement>
                    <ui:VisualElement class="meter-row" tooltip="Estimated battery state of charge integrated from wheel driving power and base avionics">
                        <ui:Label text="BATTERY (EST)" class="meter-label" />
                        <ui:VisualElement class="meter-track">
                            <ui:VisualElement name="BarBattery" class="meter-fill fill-mint" style="width: 85%;" />
                        </ui:VisualElement>
                        <ui:Label name="ValBattery" text="85%" class="meter-val" />
                    </ui:VisualElement>
                    <ui:VisualElement class="meter-row" style="margin-top: 6px;" tooltip="Lumped thermal model dT/dt = (P_loss - (T - T_ambient)/R_th) / C_th dynamically linked to planetary ambient">
                        <ui:Label text="MOTOR TEMP (EST)" class="meter-label" />
                        <ui:VisualElement class="meter-track">
                            <ui:VisualElement name="BarMotorTemp" class="meter-fill fill-cyan" style="width: 42%;" />
                        </ui:VisualElement>
                        <ui:Label name="ValMotorTemp" text="42 °C" class="meter-val" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Planetary Environment Card -->
                <ui:VisualElement name="CardEnvironment" class="studio-card env-card">
                    <ui:VisualElement class="card-header">
                        <ui:Label text="PLANETARY ENVIRONMENT" class="card-title" tooltip="Atmospheric and gravitational parameters of the active celestial body" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat-grid-2x2">
                        <ui:VisualElement class="stat-cell" tooltip="Surface gravitational acceleration (m/s²)">
                            <ui:Label text="GRAVITY" class="stat-label" />
                            <ui:Label name="ValEnvGravity" text="3.72 m/s²" class="stat-med-val val-gold" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-cell" tooltip="Mean surface ambient temperature (°C)">
                            <ui:Label text="SURFACE TEMP" class="stat-label" />
                            <ui:Label name="ValEnvTemp" text="-60°C" class="stat-med-val" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-cell" tooltip="Barometric atmospheric surface pressure (kPa)">
                            <ui:Label text="ATM PRESS" class="stat-label" />
                            <ui:Label name="ValEnvPress" text="0.6 kPa" class="stat-med-val" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-cell" tooltip="Active planetary weather or environmental hazard">
                            <ui:Label name="LabelEnvHazardTitle" text="DUST STORM" class="stat-label" />
                            <ui:Label name="ValEnvHazard" text="No" class="stat-med-val val-green" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom Control Bar -->
        <ui:VisualElement class="studio-bottom-bar hud-interactive">
            <!-- Drive Modes Group -->
            <ui:VisualElement name="GroupDriveModes" class="bottom-group">
                <ui:Label name="LblDriveGroup" text="DRIVE MODE" class="bottom-label" />
                <ui:Button name="BtnModeStop" text="STOP" class="mode-pill" tooltip="Full stop / handbrake" />
                <ui:Button name="BtnModeCruise" text="CRUISE" class="mode-pill mode-pill-active" tooltip="Standard 4WD cruise speed" />
                <ui:Button name="BtnModeExplore" text="EXPLORE" class="mode-pill" tooltip="Fast exploration speed" />
                <ui:Button name="BtnModePrecision" text="PRECISION" class="mode-pill" tooltip="Fine-tuned rock crawling" />
            </ui:VisualElement>

            <!-- Camera Perspectives Group -->
            <ui:VisualElement class="bottom-group">
                <ui:Label text="CAMERA" class="bottom-label" />
                <ui:Button name="BtnCamFront" text="FRONT" class="mode-pill" tooltip="Front rover view" />
                <ui:Button name="BtnCamRear" text="● REAR" class="mode-pill mode-pill-active" tooltip="Rear chase view" />
                <ui:Button name="BtnCamLeft" text="LEFT" class="mode-pill" tooltip="Left flank view" />
                <ui:Button name="BtnCamRight" text="RIGHT" class="mode-pill" tooltip="Right flank view" />
                <ui:Button name="BtnCamTop" text="TOP" class="mode-pill" tooltip="Top-down satellite view" />
            </ui:VisualElement>

            <!-- Controls Helper & View Toggle -->
            <ui:VisualElement class="bottom-group-right">
                <ui:Label name="LblHelperHint" text="[W,A,S,D] Drive | [V] Cam | [Tab] Studio/HUD | [H] Hide HUD" class="hud-helper-hint" tooltip="Keyboard shortcuts: Drive [W,A,S,D], Camera presets [V], Studio/HUD toggle [Tab], Hide HUD [H]" />
                <ui:Button name="BtnToggleHUD" text="VIEW [Tab]" class="hud-toggle-pill" tooltip="Toggle between Driving HUD and Full Studio [Tab]" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
