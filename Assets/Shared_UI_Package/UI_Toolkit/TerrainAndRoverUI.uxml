<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="Tokens.uss" />
    <Style src="Components.uss" />
    <Style src="TerrainAndRoverUI.uss" />

    <!-- Minimized Floating Restore Button (40x40 circle) -->
    <ui:Button name="BtnFloatingDock" class="restore-circle-btn hud-interactive" style="display: none;" tooltip="Restore Studio UI [Tab or H]">
        <ui:VisualElement class="icon-16 icon-restore tint-accent" />
    </ui:Button>

    <!-- Studio Fullscreen Root (picking-mode Ignore allows clicks through to 3D world) -->
    <ui:VisualElement name="StudioRoot" class="studio-root mode-studio" picking-mode="Ignore">

        <!-- 1. Top Placement Mode Banner -->
        <ui:VisualElement name="PlacementBanner" class="placement-banner hud-interactive" style="display: none;" picking-mode="Position">
            <ui:VisualElement class="icon-16 icon-cursor-click tint-accent" />
            <ui:Label name="LblPlacementBannerText" text="Click terrain to place rover · [Q,E] or Scroll rotates · [Esc] cancels" class="placement-banner-text" />
            <ui:Button name="BtnPlacementQuickCentre" class="btn btn-secondary placement-banner-btn" tooltip="Spawn directly at the center of the terrain">
                <ui:VisualElement class="btn-icon-leading icon-crosshair" />
                <ui:Label text="CENTRE SPAWN" class="btn-text" />
            </ui:Button>
            <ui:Button name="BtnPlacementCancel" class="btn btn-cancel placement-banner-btn" tooltip="Cancel placement and return to studio [Esc]">
                <ui:VisualElement class="btn-icon-leading icon-x" />
                <ui:Label text="CANCEL" class="btn-text" />
            </ui:Button>
        </ui:VisualElement>

        <!-- 2. Floating Top Row Shell -->
        <ui:VisualElement name="ShellTopRow" class="shell-top-row" picking-mode="Ignore">
            <!-- Mode Switch Pill (Driving HUD vs Full Studio) -->
            <ui:VisualElement class="segmented-bar mode-toggle-bar hud-interactive" picking-mode="Position">
                <ui:Button name="BtnModeDriving" class="segmented-item mode-toggle-item" tooltip="Unobstructed 3D view for driving [Tab]">
                    <ui:VisualElement class="icon-14 icon-steering-wheel tint-text-2" />
                    <ui:Label text="Driving hud" class="segmented-text" />
                </ui:Button>
                <ui:Button name="BtnModeStudio" class="segmented-item mode-toggle-item segmented-active view-switch-active" tooltip="Full mission control dashboard [Tab]">
                    <ui:VisualElement class="icon-14 icon-mountains" />
                    <ui:Label text="Full Studio" class="segmented-text" />
                </ui:Button>
            </ui:VisualElement>

            <!-- Planet Badge Pill & Minimize Pill -->
            <ui:VisualElement class="top-right-group hud-interactive" picking-mode="Position">
                <ui:Button name="BtnPlanetBadge" class="btn btn-secondary planet-pill" tooltip="Select Planet Environment [P]">
                    <ui:VisualElement class="icon-16 icon-planet tint-accent" />
                    <ui:Label name="LblPlanetName" text="MARS" class="btn-text planet-name-text" />
                </ui:Button>
                <ui:Button name="BtnMinimizeStudio" class="btn btn-secondary minimize-pill" tooltip="Minimize Studio [U]">
                    <ui:VisualElement class="icon-14 icon-minus tint-text-2" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 3. Side Columns Main Grid -->
        <ui:VisualElement name="StudioMainGrid" class="studio-main-grid" picking-mode="Ignore">

            <!-- =============================================================
                 LEFT COLUMN (316px)
                 ============================================================= -->
            <ui:VisualElement name="ColLeft" class="col-left hud-interactive" picking-mode="Position">
                <ui:ScrollView name="ScrollColLeft" class="column-scroll-view" mode="Vertical" horizontal-scroller-visibility="Hidden">

                <!-- ========================================================-
                     MODE A (DRIVING HUD): Kinematics, Attitude, Position
                     ========================================================- -->
                <!-- Card 1: Kinematics / Speed -->
                <ui:VisualElement name="CardKinematics" class="panel-card driving-only">
                    <ui:VisualElement class="panel-header-row">
                        <ui:Label text="KINEMATICS / SPEED" class="panel-title" />
                    </ui:VisualElement>
                    <ui:VisualElement class="metric-grid-2x2">
                        <ui:VisualElement class="metric-cell">
                            <ui:Label text="SPEED (LINEAR)" class="metric-label" />
                            <ui:VisualElement class="metric-value-row">
                                <ui:Label name="ValLinearSpeed" text="0.00" class="metric-value" />
                                <ui:Label text="m/s" class="metric-unit" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="metric-cell">
                            <ui:Label text="SPEED (GROUND)" class="metric-label" />
                            <ui:VisualElement class="metric-value-row">
                                <ui:Label name="ValGroundSpeed" text="0.00" class="metric-value" />
                                <ui:Label text="km/h" class="metric-unit" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="metric-cell">
                            <ui:Label text="ACCELERATION" class="metric-label" />
                            <ui:VisualElement class="metric-value-row">
                                <ui:Label name="ValAcceleration" text="+0.00" class="metric-value" />
                                <ui:Label text="m/s²" class="metric-unit" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="metric-cell">
                            <ui:Label text="G-FORCE" class="metric-label" />
                            <ui:VisualElement class="metric-value-row">
                                <ui:Label name="ValGForce" text="0.38" class="metric-value" />
                                <ui:Label text="G" class="metric-unit" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Card 2: Attitude & Orientation -->
                <ui:VisualElement name="CardAttitude" class="panel-card driving-only">
                    <ui:VisualElement class="panel-header-row">
                        <ui:Label text="ATTITUDE &amp; ORIENTATION" class="panel-title" />
                        <ui:Label name="IconAttitudeWarning" text="▲" class="attitude-warn-icon" style="display: none;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="metric-grid-2x2">
                        <ui:VisualElement class="metric-cell">
                            <ui:Label text="PITCH" class="metric-label" />
                            <ui:Label name="ValPitch" text="+0.0°" class="metric-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="metric-cell">
                            <ui:Label text="ROLL" class="metric-label" />
                            <ui:Label name="ValRoll" text="+0.0°" class="metric-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="metric-cell">
                            <ui:Label text="HEADING" class="metric-label" />
                            <ui:Label name="ValHeading" text="000° N" class="metric-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="metric-cell">
                            <ui:Label text="SLOPE" class="metric-label" />
                            <ui:Label name="ValSlope" text="0.0°" class="metric-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="BarHeadingLevel" style="display: none;" />
                </ui:VisualElement>

                <!-- Card 3: Position & Odometry -->
                <ui:VisualElement name="CardPosition" class="panel-card driving-only">
                    <ui:VisualElement class="panel-header-row">
                        <ui:Label text="POSITION &amp; ODOMETRY" class="panel-title" />
                    </ui:VisualElement>
                    <ui:Label text="WORLD COORDINATES (XYZ)" class="metric-label" />
                    <ui:Label name="ValCoords" text="X 0.00 m   Y 0.00 m   Z 0.00 m" class="stat-coords-val" />
                    <ui:VisualElement class="flex-row justify-between mt-4">
                        <ui:VisualElement class="metric-cell">
                            <ui:Label text="DISTANCE TRAVELED" class="metric-label" />
                            <ui:Label name="ValOdometer" text="0.0 m" class="metric-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="metric-cell">
                            <ui:Label text="MISSION TIME" class="metric-label" />
                            <ui:Label name="ValMissionTime" text="00:00:00" class="metric-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ========================================================-
                     MODE B (FULL STUDIO): Terrain Overview & 2D Painter
                     ========================================================- -->
                <!-- Card 1: Terrain Overview -->
                <ui:VisualElement name="CardTerrainOverview" class="panel-card studio-only">
                    <ui:VisualElement class="panel-header-row">
                        <ui:Label text="TERRAIN OVERVIEW" class="panel-title" />
                    </ui:VisualElement>

                    <!-- Square Heightmap Canvas (216px) -->
                    <ui:VisualElement name="MinimapContainer" class="canvas-frame">
                        <ui:Image name="HeightmapPreviewImage" class="canvas-image" />
                        <ui:VisualElement class="canvas-grid-overlay" />
                        <ui:VisualElement name="PainterBrushCursor" class="painter-brush-cursor" />
                        <ui:VisualElement name="MinimapBreadcrumbsContainer" class="minimap-breadcrumbs-container" />
                        <ui:VisualElement name="RadarRoverDot" class="radar-rover-dot">
                            <ui:VisualElement name="RadarRoverHeadingArrow" class="radar-rover-arrow" />
                        </ui:VisualElement>
                        <ui:Label name="LabelRadarRange" text="1000 × 1000 m" class="radar-range-tag" />
                    </ui:VisualElement>

                    <!-- Presets 3x2 Grid -->
                    <ui:VisualElement class="flex-row gap-6 mb-4">
                        <ui:Button name="BtnLabPresetGale" text="Gale Crater" class="preset-chip-btn flex-1 preset-btn-lab-active" />
                        <ui:Button name="BtnLabPresetOlympus" text="Olympus" class="preset-chip-btn flex-1" />
                        <ui:Button name="BtnLabPresetFractal" text="Fractals" class="preset-chip-btn flex-1" />
                    </ui:VisualElement>
                    <ui:VisualElement class="flex-row gap-6 mb-4">
                        <ui:Button name="BtnLabPresetShackleton" text="Shackleton" class="preset-chip-btn flex-1" />
                        <ui:Button name="BtnLabPresetValles" text="Valles" class="preset-chip-btn flex-1" />
                        <ui:Button name="BtnLabPresetPlains" text="Plains" class="preset-chip-btn flex-1" />
                    </ui:VisualElement>

                    <!-- Seed Row -->
                    <ui:VisualElement class="seed-row">
                        <ui:Label text="Seed:" class="metric-label" style="margin-bottom: 0;" />
                        <ui:IntegerField name="FieldSeed" value="0" class="text-input seed-input" />
                        <ui:Button name="BtnRandomSeed" class="btn-icon-circle-sm" tooltip="Random Seed">
                            <ui:VisualElement class="icon-14 icon-shuffle tint-accent" />
                        </ui:Button>
                    </ui:VisualElement>

                    <!-- Upload & Generate Actions Row -->
                    <ui:VisualElement class="flex-row gap-6 mt-2">
                        <ui:Button name="BtnBrowseFile" class="btn btn-secondary flex-1" tooltip="Import Grayscale PNG Heightmap">
                            <ui:VisualElement class="btn-icon-leading icon-upload" />
                            <ui:Label text="Upload img" class="btn-text" />
                        </ui:Button>
                        <ui:Button name="BtnGenerateTerrain" class="btn btn-primary flex-1" tooltip="Generate New Planetary Terrain">
                            <ui:VisualElement class="btn-icon-leading icon-mountains" />
                            <ui:Label text="Generate Terrain" class="btn-text" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Card 2: 2D Heightmap Painter -->
                <ui:VisualElement name="CardPainter" class="panel-card studio-only">
                    <ui:VisualElement class="panel-header-row">
                        <ui:Label text="2D HEIGHTMAP PAINTER" class="panel-title" />
                        <ui:VisualElement class="panel-actions-group">
                            <ui:Button name="BtnUndo" class="btn-icon-circle-sm" tooltip="Undo Last Stroke [Ctrl+Z]">
                                <ui:VisualElement class="icon-12 icon-undo tint-text-2" />
                            </ui:Button>
                            <ui:Button name="BtnRedo" class="btn-icon-circle-sm" tooltip="Redo Last Stroke [Ctrl+Y]">
                                <ui:VisualElement class="icon-12 icon-redo tint-text-2" />
                            </ui:Button>
                            <ui:Button name="BtnExportPNG" class="btn-icon-circle-sm" tooltip="Export PNG Heightmap">
                                <ui:VisualElement class="icon-12 icon-download tint-text-2" />
                            </ui:Button>
                            <ui:Label name="LabelHistoryStatus" text="0/20" class="history-tag" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 5-Segment Brush Tool Bar -->
                    <ui:VisualElement class="segmented-bar brush-segmented-bar">
                        <ui:Button name="BtnBrushRaise" class="segmented-item brush-segmented-item brush-btn-active" tooltip="Raise elevation">
                            <ui:VisualElement class="icon-12 icon-arrow-up" />
                            <ui:Label text="Rise" class="segmented-text" />
                        </ui:Button>
                        <ui:Button name="BtnBrushLower" class="segmented-item brush-segmented-item" tooltip="Lower elevation">
                            <ui:VisualElement class="icon-12 icon-arrow-down" />
                            <ui:Label text="Lower" class="segmented-text" />
                        </ui:Button>
                        <ui:Button name="BtnBrushSmooth" class="segmented-item brush-segmented-item" tooltip="Smooth terrain">
                            <ui:VisualElement class="icon-12 icon-waves" />
                            <ui:Label text="Smooth" class="segmented-text" />
                        </ui:Button>
                        <ui:Button name="BtnBrushFlatten" class="segmented-item brush-segmented-item" tooltip="Flatten to target height">
                            <ui:VisualElement class="icon-12 icon-equals" />
                            <ui:Label text="Flat" class="segmented-text" />
                        </ui:Button>
                        <ui:Button name="BtnBrushNoise" class="segmented-item brush-segmented-item" tooltip="Noise perturbation">
                            <ui:VisualElement class="icon-12 icon-waveform" />
                            <ui:Label text="Noise" class="segmented-text" />
                        </ui:Button>
                    </ui:VisualElement>

                    <!-- Brush Sliders (Compact Horizontal Rows) -->
                    <ui:VisualElement class="slider-row">
                        <ui:Label text="RADIUS" class="slider-label" />
                        <ui:Slider name="SliderBrushRadius" low-value="0.01" high-value="0.25" value="0.08" class="custom-slider" />
                        <ui:Label name="LabelBrushRadiusVal" text="8%" class="slider-val-label" />
                    </ui:VisualElement>

                    <ui:VisualElement class="slider-row">
                        <ui:Label text="STRENGTH" class="slider-label" />
                        <ui:Slider name="SliderBrushStrength" low-value="0.05" high-value="1.0" value="0.4" class="custom-slider" />
                        <ui:Label name="LabelBrushStrengthVal" text="40%" class="slider-val-label" />
                    </ui:VisualElement>

                    <ui:VisualElement class="slider-row">
                        <ui:Label text="HARDNESS" class="slider-label" />
                        <ui:Slider name="SliderBrushHardness" low-value="0.0" high-value="1.0" value="0.5" class="custom-slider" />
                        <ui:Label name="LabelBrushHardnessVal" text="50%" class="slider-val-label" />
                    </ui:VisualElement>

                    <ui:VisualElement name="RowFlattenHeight" class="slider-row" style="display: none;">
                        <ui:Label text="TARGET HT" class="slider-label" />
                        <ui:Slider name="SliderFlattenHeight" low-value="0.0" high-value="1.0" value="0.5" class="custom-slider" />
                        <ui:Label name="LabelFlattenHeightVal" text="50%" class="slider-val-label" />
                    </ui:VisualElement>

                    <ui:Image name="HeightmapPainterImage" style="display: none;" />
                </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- =============================================================
                 RIGHT COLUMN (316px)
                 ============================================================= -->
            <ui:VisualElement name="ColRight" class="col-right hud-interactive" picking-mode="Position">
                <ui:ScrollView name="ScrollColRight" class="column-scroll-view" mode="Vertical" horizontal-scroller-visibility="Hidden">

                <!-- ========================================================-
                     SHARED CARD: Deploy Digital Twin Rover
                     ========================================================- -->
                <ui:VisualElement name="CardDeployRover" class="panel-card">
                    <ui:VisualElement class="panel-header-row">
                        <ui:Label text="DEPLOY DIGITAL TWIN ROVER" class="panel-title" />
                    </ui:VisualElement>

                    <ui:VisualElement class="rover-list-group">
                        <ui:Button name="BtnRoverHusky" class="rover-row rover-row-active" tooltip="Clearpath Husky A200 (Skid-steer 4WD)">
                            <ui:VisualElement class="icon-16 icon-robot tint-accent" />
                            <ui:Label text="Clearpath Husky A200" class="rover-row-title" />
                            <ui:Label name="TagHuskyActive" text="ACTIVE" class="status-badge status-badge-active" />
                        </ui:Button>

                        <ui:Button name="BtnRoverM20" class="rover-row" tooltip="Deep Robotics M20 (Wheeled Quadruped)">
                            <ui:VisualElement class="icon-16 icon-robot tint-text-3" />
                            <ui:Label text="Deep Robotics M20" class="rover-row-title" />
                            <ui:Label name="TagM20Active" text="DEPLOY" class="status-badge" />
                        </ui:Button>

                        <ui:Button name="BtnRoverM2020" class="rover-row" tooltip="NASA Perseverance M2020 (6WD Rocker-Bogie)">
                            <ui:VisualElement class="icon-16 icon-robot tint-text-3" />
                            <ui:Label text="NASA Perseverance M2020" class="rover-row-title" />
                            <ui:Label name="TagM2020Active" text="DEPLOY" class="status-badge" />
                        </ui:Button>
                    </ui:VisualElement>

                    <!-- Rover Spawn Buttons Row -->
                    <ui:VisualElement class="flex-row gap-6 mt-4">
                        <ui:Button name="BtnRelocateRover" class="btn btn-primary flex-1" tooltip="Click terrain to spawn active rover">
                            <ui:VisualElement class="btn-icon-leading icon-cursor-click" />
                            <ui:Label text="click to spawn" class="btn-text" />
                        </ui:Button>
                        <ui:Button name="BtnQuickSpawnCentre" class="btn btn-secondary flex-1" tooltip="Spawn directly at terrain centre">
                            <ui:VisualElement class="btn-icon-leading icon-crosshair" />
                            <ui:Label text="centre spawn" class="btn-text" />
                        </ui:Button>
                        <ui:Button name="BtnCenterRover" style="display: none;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ========================================================-
                     MODE A (DRIVING HUD): Actuators & Planetary Environment
                     ========================================================- -->
                <!-- Card 2: Actuators / Wheel Traction -->
                <ui:VisualElement name="CardActuators" class="panel-card driving-only">
                    <ui:VisualElement class="panel-header-row">
                        <ui:Label text="ACTUATORS / WHEEL TRACTION" class="panel-title" />
                    </ui:VisualElement>
                    <ui:VisualElement name="WheelContainer" class="wheel-grid-container">
                        <!-- FL Wheel Tile -->
                        <ui:VisualElement class="wheel-tile">
                            <ui:VisualElement class="flex-row align-center">
                                <ui:Label text="FL" class="wheel-tile-name" />
                                <ui:Label name="TagWheelFL" text="GOOD" class="wheel-status-text" />
                            </ui:VisualElement>
                            <ui:VisualElement name="SegsWheelFL" class="wheel-traction-bar">
                                <ui:VisualElement class="wheel-segment seg-active" />
                                <ui:VisualElement class="wheel-segment seg-active" />
                                <ui:VisualElement class="wheel-segment seg-active" />
                                <ui:VisualElement class="wheel-segment seg-active" />
                                <ui:VisualElement class="wheel-segment seg-active" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- FR Wheel Tile -->
                        <ui:VisualElement class="wheel-tile">
                            <ui:VisualElement class="flex-row align-center">
                                <ui:Label text="FR" class="wheel-tile-name" />
                                <ui:Label name="TagWheelFR" text="GOOD" class="wheel-status-text" />
                            </ui:VisualElement>
                            <ui:VisualElement name="SegsWheelFR" class="wheel-traction-bar">
                                <ui:VisualElement class="wheel-segment seg-active" />
                                <ui:VisualElement class="wheel-segment seg-active" />
                                <ui:VisualElement class="wheel-segment seg-active" />
                                <ui:VisualElement class="wheel-segment seg-active" />
                                <ui:VisualElement class="wheel-segment seg-active" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- RL Wheel Tile -->
                        <ui:VisualElement class="wheel-tile">
                            <ui:VisualElement class="flex-row align-center">
                                <ui:Label text="RL" class="wheel-tile-name" />
                                <ui:Label name="TagWheelRL" text="GOOD" class="wheel-status-text" />
                            </ui:VisualElement>
                            <ui:VisualElement name="SegsWheelRL" class="wheel-traction-bar">
                                <ui:VisualElement class="wheel-segment seg-active" />
                                <ui:VisualElement class="wheel-segment seg-active" />
                                <ui:VisualElement class="wheel-segment seg-active" />
                                <ui:VisualElement class="wheel-segment seg-active" />
                                <ui:VisualElement class="wheel-segment seg-active" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- RR Wheel Tile -->
                        <ui:VisualElement class="wheel-tile">
                            <ui:VisualElement class="flex-row align-center">
                                <ui:Label text="RR" class="wheel-tile-name" />
                                <ui:Label name="TagWheelRR" text="GOOD" class="wheel-status-text" />
                            </ui:VisualElement>
                            <ui:VisualElement name="SegsWheelRR" class="wheel-traction-bar">
                                <ui:VisualElement class="wheel-segment seg-active" />
                                <ui:VisualElement class="wheel-segment seg-active" />
                                <ui:VisualElement class="wheel-segment seg-active" />
                                <ui:VisualElement class="wheel-segment seg-active" />
                                <ui:VisualElement class="wheel-segment seg-active" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Card 3: Planetary Environment -->
                <ui:VisualElement name="CardEnvironment" class="panel-card driving-only">
                    <ui:VisualElement class="panel-header-row">
                        <ui:Label text="PLANETARY ENVIRONMENT" class="panel-title" />
                    </ui:VisualElement>
                    <ui:VisualElement class="metric-grid-2x2">
                        <ui:VisualElement class="metric-cell">
                            <ui:Label text="GRAVITY" class="metric-label" />
                            <ui:Label name="ValEnvGravity" text="3.72 m/s²" class="metric-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="metric-cell">
                            <ui:Label text="SURFACE TEMP" class="metric-label" />
                            <ui:Label name="ValEnvTemp" text="-60 °C" class="metric-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="metric-cell">
                            <ui:Label text="ATM PRESS" class="metric-label" />
                            <ui:Label name="ValEnvPress" text="0.6 kPa" class="metric-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="metric-cell">
                            <ui:Label name="LabelEnvHazardTitle" text="DUST STORM" class="metric-label" />
                            <ui:Label name="ValEnvHazard" text="No" class="metric-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ========================================================-
                     MODE B (FULL STUDIO): Elevation Tuning & Materials
                     ========================================================- -->
                <!-- Card 2: Elevation & Spatial Tuning -->
                <ui:VisualElement name="CardElevation" class="panel-card studio-only">
                    <ui:VisualElement class="panel-header-row">
                        <ui:Label text="ELEVATION &amp; SPATIAL TUNING" class="panel-title" />
                    </ui:VisualElement>

                    <ui:VisualElement class="slider-row">
                        <ui:Label text="SCALE" class="slider-label" />
                        <ui:Slider name="SliderMaxHeight" low-value="5" high-value="500" value="120" class="custom-slider" />
                        <ui:Label name="LabelMaxHeightVal" text="120 m" class="slider-val-label" />
                    </ui:VisualElement>

                    <ui:VisualElement class="slider-row">
                        <ui:Label text="BASE OFFSET" class="slider-label" />
                        <ui:Slider name="SliderBaseOffset" low-value="-50" high-value="50" value="0" class="custom-slider" />
                        <ui:Label name="LabelBaseOffsetVal" text="0 m" class="slider-val-label" />
                    </ui:VisualElement>

                    <ui:VisualElement class="slider-row">
                        <ui:Label text="TERRAIN SIZE" class="slider-label" />
                        <ui:Slider name="SliderTerrainSize" low-value="200" high-value="2000" value="1000" class="custom-slider" />
                        <ui:Label name="LabelTerrainSizeVal" text="1000m" class="slider-val-label" />
                    </ui:VisualElement>

                    <!-- Dropdown Resolution Field -->
                    <ui:VisualElement class="slider-row" style="height: 24px; margin-bottom: 3px;">
                        <ui:Label text="RESOLUTION" class="slider-label" />
                        <ui:DropdownField name="DropdownResolution" class="custom-dropdown flex-1" choices="257 x 257 (High Detail),513 x 513 (Very High),1025 x 1025 (Ultra Detail),2049 x 2049 (Extreme)" value="513 x 513 (Very High)" />
                    </ui:VisualElement>

                    <ui:VisualElement class="slider-row">
                        <ui:Label text="SMOOTHING" class="slider-label" />
                        <ui:Slider name="SliderSmoothing" low-value="0" high-value="5" value="1" class="custom-slider" />
                        <ui:Label name="LabelSmoothingVal" text="1.0" class="slider-val-label" />
                    </ui:VisualElement>

                    <!-- 4-Segment Curve Control -->
                    <ui:VisualElement class="slider-row" style="height: 24px; margin-top: 2px;">
                        <ui:Label text="CURVE REMAP" class="slider-label" />
                        <ui:VisualElement class="segmented-bar curve-segmented-bar flex-1">
                            <ui:Button name="BtnCurveLinear" text="Linear" class="segmented-item curve-btn-active" />
                            <ui:Button name="BtnCurveExponential" text="Exp" class="segmented-item" />
                            <ui:Button name="BtnCurveRidge" text="Ridge" class="segmented-item" />
                            <ui:Button name="BtnCurveBasin" text="Basin" class="segmented-item" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Card 3: Planetary Surface Material -->
                <ui:VisualElement name="CardMaterial" class="panel-card studio-only">
                    <ui:VisualElement class="panel-header-row">
                        <ui:Label text="SURFACE MATERIAL" class="panel-title" />
                        <ui:Toggle name="ToggleFollowPlanet" label="Planet sync" class="custom-toggle" value="true" />
                    </ui:VisualElement>

                    <!-- 7 Material Chips (2-Column Rows) -->
                    <ui:VisualElement class="flex-row gap-6 mb-4">
                        <ui:Button name="BtnMatMartian" class="material-chip-btn flex-1 material-btn-active">
                            <ui:VisualElement class="color-swatch-circle" style="background-color: #C65135;" />
                            <ui:Label text="Martian Rust" class="material-chip-label" />
                        </ui:Button>
                        <ui:Button name="BtnMatLunar" class="material-chip-btn flex-1">
                            <ui:VisualElement class="color-swatch-circle" style="background-color: #9E9E9E;" />
                            <ui:Label text="Lunar Regolith" class="material-chip-label" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="flex-row gap-6 mb-4">
                        <ui:Button name="BtnMatBasalt" class="material-chip-btn flex-1">
                            <ui:VisualElement class="color-swatch-circle" style="background-color: #2B2D31;" />
                            <ui:Label text="Volcanic Basalt" class="material-chip-label" />
                        </ui:Button>
                        <ui:Button name="BtnMatIce" class="material-chip-btn flex-1">
                            <ui:VisualElement class="color-swatch-circle" style="background-color: #78D5E3;" />
                            <ui:Label text="Polar Cryo-Ice" class="material-chip-label" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="flex-row gap-6 mb-4">
                        <ui:Button name="BtnMatCanyon" class="material-chip-btn flex-1">
                            <ui:VisualElement class="color-swatch-circle" style="background-color: #A0522D;" />
                            <ui:Label text="Red Sandstone" class="material-chip-label" />
                        </ui:Button>
                        <ui:Button name="BtnMatWireframe" class="material-chip-btn flex-1">
                            <ui:VisualElement class="color-swatch-circle" style="background-color: #31D07F;" />
                            <ui:Label text="Topo Grid" class="material-chip-label" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="flex-row gap-6 mb-4">
                        <ui:Button name="BtnMatNormal" class="material-chip-btn flex-1">
                            <ui:VisualElement class="color-swatch-circle" style="background-color: #B388FF;" />
                            <ui:Label text="Normal Insp" class="material-chip-label" />
                        </ui:Button>
                        <ui:VisualElement class="flex-1" style="visibility: hidden;" />
                    </ui:VisualElement>

                    <!-- Live preview switch & Apply button (Compact Row) -->
                    <ui:VisualElement class="flex-row justify-between align-center mt-2">
                        <ui:Toggle name="ToggleLivePreview" label="Live preview" class="custom-toggle" value="false" />
                        <ui:Button name="BtnApplyTerrainLab" class="btn btn-confirm" style="height: 26px; padding: 0 10px;" tooltip="Syncs TerrainCollider &amp; auto-respawns active rover">
                            <ui:VisualElement class="btn-icon-leading icon-refresh" />
                            <ui:Label text="Apply and rebuild" class="btn-text" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 4. Floating Bottom Shell Controls -->
        <!-- Bottom-Left: Camera Perspectives -->
        <ui:VisualElement name="ShellBottomLeft" class="shell-bottom-left" picking-mode="Position">
            <ui:Label text="Camera" class="pill-label" />
            <ui:VisualElement class="segmented-bar bottom-segmented-bar">
                <ui:Button name="BtnCamFront" text="Front" class="segmented-item" tooltip="Front rover chase view" />
                <ui:Button name="BtnCamRear" text="Rear" class="segmented-item mode-pill-active segmented-active" tooltip="Rear chase view" />
                <ui:Button name="BtnCamLeft" text="Left" class="segmented-item" tooltip="Left flank view" />
                <ui:Button name="BtnCamRight" text="Right" class="segmented-item" tooltip="Right flank view" />
                <ui:Button name="BtnCamTop" text="Free" class="segmented-item" tooltip="Top-down satellite view" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom-Right: Driving Modes -->
        <ui:VisualElement name="ShellBottomRight" class="shell-bottom-right" picking-mode="Position">
            <ui:Label name="LblDriveGroup" text="Driving mode" class="pill-label" />
            <ui:VisualElement name="GroupDriveModes" class="segmented-bar bottom-segmented-bar">
                <ui:Button name="BtnModeStop" text="Stop" class="segmented-item" tooltip="Full stop / handbrake" />
                <ui:Button name="BtnModeCruise" text="Cruise" class="segmented-item mode-pill-active segmented-active" tooltip="Standard cruise speed" />
                <ui:Button name="BtnModeExplore" text="Explore" class="segmented-item" tooltip="Fast exploration speed" />
                <ui:Button name="BtnModePrecision" text="Precision" class="segmented-item" tooltip="Fine-tuned rock crawling" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
