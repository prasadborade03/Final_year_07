/* VR ROVER DIGITAL TWIN STUDIO - User Friendly Aerospace Mission Control Theme */

/* ========================================================================= */
/* 0. BASE CONTAINER & MODES                                                 */
/* ========================================================================= */
.studio-root {
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    bottom: 8px;
    background-color: rgba(9, 14, 22, 0.90);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(30, 48, 72, 0.7);
    padding: 10px 12px;
    flex-direction: column;
    overflow: hidden;
}

/* Driving HUD Mode: 100% transparent backdrop so 3D simulation is unobstructed */
.hud-mode-root {
    background-color: transparent;
    border-width: 0;
    pointer-events: none;
}

/* Ensure interactive pods catch clicks in HUD mode */
.hud-interactive {
    pointer-events: auto;
}

/* Floating Mini-Dock when Studio is completely minimized */
.floating-dock-btn {
    position: absolute;
    top: 10px;
    left: 10px;
    background-color: rgba(14, 22, 34, 0.95);
    border-width: 1.5px;
    border-color: #00e5ff;
    border-radius: 16px;
    color: #00e5ff;
    padding: 6px 14px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.floating-dock-btn:hover {
    background-color: rgba(0, 229, 255, 0.25);
    color: #ffffff;
}

/* ========================================================================= */
/* 1. TOP HEADER BAR                                                         */
/* ========================================================================= */
.studio-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(30, 41, 59, 0.6);
    padding-bottom: 6px;
    margin-bottom: 6px;
    background-color: rgba(14, 21, 32, 0.85);
    border-radius: 8px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
}

.header-left {
    flex-direction: row;
    align-items: center;
}

.studio-logo-icon {
    width: 14px;
    height: 14px;
    margin-right: 8px;
    background-color: #00e5ff;
    border-radius: 3px;
    opacity: 0.9;
}

.studio-title {
    font-size: 14px;
    color: #f1f5f9;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
}

.header-center {
    flex-direction: row;
    align-items: center;
}

.view-switch-pill {
    padding: 4px 12px;
    border-radius: 10px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.4px;
    margin-left: 3px;
    margin-right: 3px;
    background-color: rgba(24, 34, 48, 0.85);
    border-width: 1px;
    border-color: rgba(30, 41, 59, 0.8);
    color: #94a3b8;
}

.view-switch-pill:hover {
    color: #ffffff;
    background-color: rgba(0, 229, 255, 0.2);
}

.view-switch-pill:active {
    background-color: rgba(0, 229, 255, 0.35);
    color: #ffffff;
}

.view-switch-active {
    background-color: rgba(0, 229, 255, 0.25);
    border-color: #00e5ff;
    color: #ffffff;
}

.header-right {
    flex-direction: row;
    align-items: center;
}

.header-pill {
    padding: 4px 10px;
    border-radius: 10px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.4px;
    margin-left: 6px;
    border-width: 1px;
}

.pill-active {
    background-color: rgba(6, 78, 59, 0.75);
    border-color: rgba(52, 211, 153, 0.6);
    color: #34d399;
}

.pill-standby {
    background-color: rgba(120, 53, 15, 0.75);
    border-color: rgba(245, 158, 11, 0.6);
    color: #fbbf24;
}

.pill-planet {
    background-color: rgba(30, 41, 59, 0.85);
    border-color: rgba(148, 163, 184, 0.35);
    color: #cbd5e1;
}

.pill-planet:hover {
    background-color: rgba(0, 229, 255, 0.25);
    border-color: #00e5ff;
    color: #ffffff;
}

.pill-planet:active {
    background-color: rgba(0, 229, 255, 0.4);
    color: #ffffff;
}

.pill-mode {
    background-color: rgba(30, 41, 59, 0.8);
    border-color: rgba(148, 163, 184, 0.3);
    color: #94a3b8;
}

.window-minimize-btn {
    width: 24px;
    height: 20px;
    background-color: rgba(30, 41, 59, 0.6);
    border-width: 1px;
    border-color: rgba(148, 163, 184, 0.3);
    border-radius: 5px;
    color: #cbd5e1;
    font-size: 11px;
    -unity-text-align: middle-center;
    margin-left: 8px;
    padding: 0;
}

.window-minimize-btn:hover {
    background-color: rgba(239, 68, 68, 0.35);
    border-color: #ef4444;
    color: #ffffff;
}

/* ========================================================================= */
/* 2. MAIN 3-COLUMN GRID                                                     */
/* ========================================================================= */
.studio-main-grid {
    flex-direction: row;
    flex-grow: 1;
    justify-content: space-between;
}

.studio-col {
    flex-direction: column;
}

.col-left {
    width: 31%;
}

.col-center {
    width: 36%;
}

.col-right {
    width: 31%;
}

/* Cards: >= 85% opacity in all modes for robust legibility against complex 3D planetary terrain */
.studio-card {
    background-color: rgba(9, 14, 24, 0.90);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(30, 48, 72, 0.85);
    padding: 8px 10px;
    margin-bottom: 6px;
}

.hud-mode-root .studio-card {
    background-color: rgba(9, 14, 24, 0.90);
    border-color: rgba(0, 229, 255, 0.35);
}

.card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 5px;
}

.card-title {
    font-size: 12px;
    color: #cbd5e1;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.card-mini-btn {
    background-color: rgba(30, 41, 59, 0.85);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.4);
    border-radius: 5px;
    color: #00e5ff;
    padding: 3px 8px;
    font-size: 11px;
    -unity-font-style: bold;
}

.card-mini-btn:hover {
    background-color: rgba(0, 229, 255, 0.25);
    color: #ffffff;
}

.card-mini-btn:active {
    background-color: rgba(0, 229, 255, 0.45);
    color: #ffffff;
}

.card-mini-btn:disabled {
    opacity: 0.4;
    border-color: rgba(71, 85, 105, 0.4);
    color: #64748b;
}

/* Stat Grids */
.stat-grid-2x2 {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.stat-grid-2x1 {
    flex-direction: row;
    justify-content: space-between;
}

.stat-cell {
    width: 48%;
    margin-bottom: 4px;
}

.stat-label {
    font-size: 11px;
    color: #94a3b8;
    -unity-font-style: bold;
    letter-spacing: 0.3px;
    margin-bottom: 2px;
}

.val-unit-row {
    flex-direction: row;
    align-items: flex-end;
}

.stat-big-val {
    font-size: 24px;
    color: #ffffff;
    -unity-font-style: bold;
    letter-spacing: 0.3px;
}

.stat-med-val {
    font-size: 14px;
    color: #ffffff;
    -unity-font-style: bold;
}

.stat-unit {
    font-size: 11px;
    color: #94a3b8;
    margin-left: 4px;
    margin-bottom: 2px;
}

.stat-coords-val {
    font-size: 12px;
    color: #80d8ff;
    -unity-font-style: bold;
    margin-top: 2px;
}

.val-green {
    color: #34d399;
}

.val-cyan {
    color: #00e5ff;
}

.val-gold {
    color: #fbbf24;
}

/* Attitude Sub Row */
.heading-sub-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.heading-bar-bg {
    flex-grow: 1;
    height: 3px;
    background-color: rgba(30, 41, 59, 0.8);
    border-radius: 2px;
    overflow: hidden;
}

.heading-bar-fill {
    height: 100%;
    background-color: #34d399;
    border-radius: 2px;
}

.attitude-warn-icon {
    font-size: 8px;
    color: #ef4444;
    margin-left: 4px;
}

/* ========================================================================= */
/* CENTER COLUMN: RADAR & DEPLOY ROVER                                       */
/* ========================================================================= */
.center-radar-card {
    align-items: center;
}

.minimap-container {
    width: 160px;
    height: 160px;
    border-radius: 8px;
    background-color: rgba(6, 12, 18, 0.95);
    border-width: 1.5px;
    border-color: rgba(0, 229, 255, 0.4);
    position: relative;
    justify-content: center;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 4px;
    overflow: hidden;
}

.minimap-elevation-image {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0.92;
}

.minimap-grid-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.15);
    pointer-events: none;
}

.minimap-breadcrumbs-container {
    position: absolute;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.breadcrumb-dot {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(0, 229, 255, 0.7);
    margin-left: -2px;
    margin-top: -2px;
}

.radar-rover-dot {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgba(16, 185, 129, 0.9);
    border-width: 1.5px;
    border-color: #ffffff;
    justify-content: center;
    align-items: center;
    margin-left: -7px;
    margin-top: -7px;
}

.radar-rover-arrow {
    width: 0;
    height: 0;
    border-left-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 6px;
    border-left-color: transparent;
    border-right-color: transparent;
    border-bottom-color: #ffffff;
    margin-bottom: 1px;
}

.radar-legend-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    padding-left: 4px;
    padding-right: 4px;
    margin-bottom: 5px;
}

.radar-legend-tag {
    font-size: 8px;
    color: #34d399;
    -unity-font-style: bold;
}

.radar-range-tag {
    font-size: 8px;
    color: #64748b;
    -unity-font-style: bold;
}

.center-presets-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 5px;
}

.studio-preset-pill {
    flex-grow: 1;
    background-color: rgba(24, 34, 48, 0.85);
    border-width: 1px;
    border-color: rgba(30, 41, 59, 0.8);
    border-radius: 5px;
    color: #cbd5e1;
    font-size: 11px;
    padding: 4px 6px;
    margin: 1px;
    -unity-text-align: middle-center;
}

.studio-preset-pill:hover {
    background-color: rgba(0, 229, 255, 0.2);
    color: #ffffff;
}

.studio-preset-pill:active {
    background-color: rgba(0, 229, 255, 0.4);
    color: #ffffff;
}

.studio-preset-pill:disabled {
    opacity: 0.45;
    color: #64748b;
}

.preset-active {
    background-color: rgba(0, 229, 255, 0.25);
    border-color: #00e5ff;
    color: #ffffff;
    -unity-font-style: bold;
}

.studio-generate-btn {
    width: 100%;
    background-color: rgba(0, 180, 216, 0.22);
    border-width: 1.5px;
    border-color: #00e5ff;
    border-radius: 7px;
    color: #ffffff;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    padding: 8px 6px;
    -unity-text-align: middle-center;
}

.studio-generate-btn:hover {
    background-color: rgba(0, 229, 255, 0.4);
}

.studio-generate-btn:active {
    background-color: rgba(0, 229, 255, 0.55);
    border-color: #38bdf8;
}

.studio-generate-btn:disabled {
    opacity: 0.5;
    background-color: rgba(30, 41, 59, 0.6);
    border-color: rgba(100, 116, 139, 0.4);
    color: #94a3b8;
}

/* Deploy Rover Card */
.rover-list {
    flex-direction: column;
}

.rover-item-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(24, 34, 48, 0.7);
    border-width: 1px;
    border-color: rgba(30, 41, 59, 0.6);
    border-radius: 6px;
    padding: 6px 10px;
    margin-bottom: 3px;
}

.rover-item-row:hover {
    background-color: rgba(0, 229, 255, 0.15);
    border-color: #00e5ff;
}

.rover-item-row:active {
    background-color: rgba(0, 229, 255, 0.3);
}

.rover-item-row:disabled {
    opacity: 0.45;
}

.rover-active-row {
    background-color: rgba(6, 78, 59, 0.25);
    border-color: rgba(52, 211, 153, 0.5);
}

.rover-name-row {
    flex-direction: row;
    align-items: center;
}

.rover-item-name {
    font-size: 12px;
    color: #e2e8f0;
    -unity-font-style: bold;
}

.rover-active-tag {
    font-size: 11px;
    color: #34d399;
    background-color: rgba(6, 78, 59, 0.6);
    border-radius: 6px;
    padding: 2px 6px;
    -unity-font-style: bold;
}

.rover-idle-tag {
    font-size: 11px;
    color: #94a3b8;
    background-color: rgba(30, 41, 59, 0.6);
    border-radius: 6px;
    padding: 2px 6px;
}

/* Empty State Standby Notice */
.rover-empty-state-banner {
    background-color: rgba(245, 158, 11, 0.15);
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.5);
    border-radius: 6px;
    padding: 5px 8px;
    margin-bottom: 6px;
}

.empty-state-text {
    font-size: 11px;
    color: #fbbf24;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ========================================================================= */
/* RIGHT COLUMN: ACTUATORS, POWER, ENVIRONMENT                               */
/* ========================================================================= */

/* Wheel Actuators Discrete 5-Segment Grid */
.wheel-grid-2x2 {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.wheel-cell {
    width: 48%;
    background-color: rgba(24, 34, 48, 0.6);
    border-radius: 5px;
    padding: 3px 5px;
    margin-bottom: 3px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.wheel-info-col {
    flex-direction: column;
}

.wheel-name {
    font-size: 8px;
    color: #cbd5e1;
    -unity-font-style: bold;
}

.wheel-status {
    font-size: 7px;
    -unity-font-style: bold;
    margin-top: 1px;
}

.tag-good { color: #34d399; }
.tag-fair { color: #fbbf24; }
.tag-slip { color: #f87171; }

.wheel-segments-row {
    flex-direction: row;
    align-items: center;
}

.wheel-seg {
    width: 5px;
    height: 10px;
    border-radius: 1px;
    margin-left: 2px;
}

.seg-active {
    background-color: #00e5ff;
}

.seg-fair {
    background-color: #fbbf24;
}

.seg-slip {
    background-color: #ef4444;
}

.seg-inactive {
    background-color: rgba(30, 41, 59, 0.85);
}

/* Power & Thermal */
.meter-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.meter-label {
    font-size: 8px;
    color: #94a3b8;
    width: 65px;
    -unity-font-style: bold;
}

.meter-track {
    flex-grow: 1;
    height: 5px;
    background-color: rgba(30, 41, 59, 0.8);
    border-radius: 3px;
    margin-left: 6px;
    margin-right: 6px;
    overflow: hidden;
}

.meter-fill {
    height: 100%;
    border-radius: 3px;
}

.fill-mint { background-color: #34d399; }
.fill-cyan { background-color: #00e5ff; }

.meter-val {
    font-size: 9px;
    color: #ffffff;
    -unity-font-style: bold;
    width: 35px;
    -unity-text-align: middle-right;
}

/* ========================================================================= */
/* 3. BOTTOM CONTROL BAR                                                     */
/* ========================================================================= */
.studio-bottom-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(14, 21, 32, 0.90);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(30, 41, 59, 0.7);
    padding: 4px 8px;
    margin-top: 4px;
    flex-shrink: 0;
    overflow: hidden;
}

.bottom-group {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.bottom-group-right {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.bottom-label {
    font-size: 10px;
    color: #64748b;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    margin-right: 4px;
}

.mode-pill {
    background-color: rgba(24, 34, 48, 0.85);
    border-width: 1px;
    border-color: rgba(30, 41, 59, 0.8);
    border-radius: 8px;
    color: #94a3b8;
    font-size: 10px;
    padding: 3px 7px;
    margin-right: 2px;
    -unity-font-style: bold;
}

.mode-pill:hover {
    color: #ffffff;
    background-color: rgba(0, 229, 255, 0.2);
}

.mode-pill:active {
    background-color: rgba(0, 229, 255, 0.4);
    color: #ffffff;
}

.mode-pill:disabled {
    opacity: 0.4;
    color: #64748b;
}

.mode-pill-active {
    background-color: rgba(0, 229, 255, 0.18);
    border-color: #00e5ff;
    color: #00e5ff;
}

.hud-helper-hint {
    font-size: 11px;
    color: #94a3b8;
    -unity-font-style: bold;
    margin-right: 8px;
}

.hud-toggle-pill {
    background-color: rgba(30, 41, 59, 0.85);
    border-width: 1px;
    border-color: rgba(148, 163, 184, 0.35);
    border-radius: 10px;
    color: #cbd5e1;
    font-size: 11px;
    padding: 4px 12px;
    -unity-font-style: bold;
}

.hud-toggle-pill:hover {
    background-color: rgba(0, 229, 255, 0.2);
    color: #ffffff;
}

.hud-toggle-pill:active {
    background-color: rgba(0, 229, 255, 0.45);
    color: #ffffff;
}

.hud-toggle-pill:disabled {
    opacity: 0.4;
    color: #64748b;
}

/* ========================================================================= */
/* 8. PLACEMENT MODE BANNER                                                  */
/* ========================================================================= */
.placement-banner {
    position: absolute;
    top: 14px;
    align-self: center;
    background-color: rgba(9, 14, 22, 0.94);
    border-radius: 20px;
    border-width: 1.5px;
    border-color: #00e5ff;
    padding: 8px 16px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.placement-banner-text {
    font-size: 11px;
    color: #f1f5f9;
    -unity-font-style: bold;
    margin-right: 14px;
}

.placement-banner-btn {
    background-color: rgba(0, 229, 255, 0.15);
    border-width: 1px;
    border-color: #00e5ff;
    border-radius: 12px;
    color: #00e5ff;
    font-size: 9px;
    padding: 4px 10px;
    margin-left: 6px;
    -unity-font-style: bold;
}

.placement-banner-btn:hover {
    background-color: rgba(0, 229, 255, 0.35);
    color: #ffffff;
}

.placement-banner-btn.btn-cancel {
    background-color: rgba(239, 68, 68, 0.15);
    border-color: #ef4444;
    color: #ef4444;
}

.placement-banner-btn.btn-cancel:hover {
    background-color: rgba(239, 68, 68, 0.35);
    color: #ffffff;
}

/* ========================================================================= */
/* 7. TERRAIN LAB WORKBENCH STYLES                                            */
/* ========================================================================= */
.studio-tab-bar {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
    background-color: rgba(14, 21, 32, 0.85);
    border-radius: 8px;
    padding: 3px;
    border-width: 1px;
    border-color: rgba(30, 41, 59, 0.6);
}

.studio-tab-btn {
    flex-grow: 1;
    padding: 5px 8px;
    border-radius: 6px;
    border-width: 0;
    background-color: transparent;
    color: #94a3b8;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    -unity-text-align: middle-center;
}

.studio-tab-btn:hover {
    background-color: rgba(0, 229, 255, 0.15);
    color: #e2e8f0;
}

.studio-tab-btn-active {
    background-color: rgba(0, 229, 255, 0.25);
    border-width: 1px;
    border-color: #00e5ff;
    color: #00e5ff;
}

.tab-view-container {
    flex-grow: 1;
}

.terrain-lab-scroll {
    flex-grow: 1;
    max-height: 800px;
}

.painter-canvas-wrapper {
    align-items: center;
    margin-bottom: 6px;
}

.painter-canvas-image {
    width: 180px;
    height: 180px;
    border-radius: 8px;
    border-width: 2px;
    border-color: #00e5ff;
    background-color: #020617;
}

.canvas-hint {
    font-size: 8px;
    color: #64748b;
    margin-top: 3px;
}

.brush-bar {
    flex-direction: row;
    justify-content: space-between;
    background-color: rgba(15, 23, 42, 0.8);
    border-radius: 6px;
    padding: 2px;
    margin-bottom: 6px;
}

.brush-btn {
    flex-grow: 1;
    font-size: 9px;
    color: #cbd5e1;
    background-color: transparent;
    border-width: 0;
    border-radius: 4px;
    padding: 4px 2px;
    margin: 1px;
    -unity-text-align: middle-center;
}

.brush-btn:hover {
    background-color: rgba(0, 229, 255, 0.2);
    color: #ffffff;
}

.brush-btn-active {
    background-color: #f97316;
    color: #020617;
    -unity-font-style: bold;
}

.history-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(15, 23, 42, 0.6);
    border-radius: 6px;
    padding: 3px 6px;
    margin-bottom: 6px;
}

.history-btn {
    font-size: 9px;
    color: #cbd5e1;
    background-color: rgba(30, 41, 59, 0.7);
    border-width: 1px;
    border-color: rgba(148, 163, 184, 0.2);
    border-radius: 5px;
    padding: 3px 8px;
}

.history-btn:hover {
    background-color: rgba(0, 229, 255, 0.2);
    border-color: #00e5ff;
}

.history-lbl {
    font-size: 8px;
    color: #94a3b8;
}

.curve-bar {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 3px;
    margin-bottom: 6px;
}

.curve-btn {
    flex-grow: 1;
    font-size: 8px;
    color: #94a3b8;
    background-color: rgba(30, 41, 59, 0.6);
    border-width: 1px;
    border-color: rgba(148, 163, 184, 0.2);
    border-radius: 5px;
    padding: 3px;
    margin: 1px;
    -unity-text-align: middle-center;
}

.curve-btn:hover {
    background-color: rgba(0, 229, 255, 0.15);
}

.curve-btn-active {
    background-color: rgba(249, 115, 22, 0.3);
    border-color: #f97316;
    color: #fdba74;
    -unity-font-style: bold;
}

.material-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 4px;
    margin-bottom: 4px;
}

.material-btn {
    width: 48%;
    font-size: 8px;
    color: #cbd5e1;
    background-color: rgba(30, 41, 59, 0.7);
    border-width: 1px;
    border-color: rgba(148, 163, 184, 0.2);
    border-radius: 6px;
    padding: 4px;
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

.material-btn:hover {
    border-color: #00e5ff;
}

.material-btn-active {
    background-color: rgba(249, 115, 22, 0.25);
    border-color: #f97316;
    color: #fdba74;
    -unity-font-style: bold;
}

.lab-toggle {
    font-size: 9px;
    color: #cbd5e1;
    margin-top: 2px;
    margin-bottom: 4px;
}

.lab-toggle > .unity-toggle__label {
    color: #cbd5e1;
    font-size: 9px;
}

.preset-grid-lab {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 4px;
}

.preset-btn-lab {
    width: 31%;
    font-size: 8px;
    color: #cbd5e1;
    background-color: rgba(30, 41, 59, 0.7);
    border-width: 1px;
    border-color: rgba(148, 163, 184, 0.2);
    border-radius: 5px;
    padding: 3px 1px;
    margin-bottom: 3px;
    -unity-text-align: middle-center;
}

.preset-btn-lab:hover {
    border-color: #00e5ff;
}

.preset-btn-lab-active {
    background-color: rgba(0, 229, 255, 0.25);
    border-color: #00e5ff;
    color: #00e5ff;
    -unity-font-style: bold;
}

.file-ops-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 4px;
}

.file-op-btn {
    width: 48%;
    font-size: 8px;
    color: #cbd5e1;
    background-color: rgba(30, 41, 59, 0.7);
    border-width: 1px;
    border-color: rgba(148, 163, 184, 0.2);
    border-radius: 5px;
    padding: 4px 2px;
    -unity-text-align: middle-center;
}

.file-op-btn:hover {
    border-color: #00e5ff;
    color: #ffffff;
}

.param-name {
    color: #94a3b8;
    font-size: 8px;
    -unity-font-style: bold;
}

.param-val {
    color: #00e5ff;
    font-size: 8px;
    -unity-font-style: bold;
}

.slider-label-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
}

.slider-row {
    margin-bottom: 4px;
}

.slider-row > .unity-slider {
    margin-top: 0;
    margin-bottom: 0;
}

.slider-row .unity-base-slider__dragger {
    background-color: #00e5ff;
    border-radius: 4px;
    border-width: 1px;
    border-color: #ffffff;
    height: 12px;
    width: 12px;
}

.slider-row .unity-base-slider__tracker {
    background-color: rgba(30, 41, 59, 0.8);
    border-color: rgba(148, 163, 184, 0.25);
    height: 4px;
}

.lab-dropdown .unity-base-field__label,
#DropdownResolution .unity-base-field__label {
    color: #94a3b8;
    font-size: 8px;
    -unity-font-style: bold;
    min-width: 80px;
}

.lab-dropdown .unity-base-popup-field__input,
#DropdownResolution .unity-base-popup-field__input {
    background-color: rgba(30, 41, 59, 0.8);
    border-color: rgba(148, 163, 184, 0.3);
    border-radius: 5px;
    padding: 3px 6px;
}

.lab-dropdown .unity-base-popup-field__text,
#DropdownResolution .unity-base-popup-field__text {
    color: #00e5ff;
    font-size: 8px;
    -unity-font-style: bold;
}


