/* =========================================================================
   TerrainAndRoverUI.uss - VR Rover Digital Twin Studio UI Stylesheet
   Pure Black Technical Theme · Strict Rectangular Language (8px panels, 6px controls)
   Multi-resolution responsive layout & 2D heightmap painter support
   ========================================================================= */

/* -------------------------------------------------------------------------
   0. Root Container & Viewport Pass-through
   ------------------------------------------------------------------------- */
.studio-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: transparent;
    pointer-events: none;
    overflow: hidden;
}

/* In Driving HUD Mode, background is completely clear */
.hud-mode-root {
    background-color: transparent;
    border-width: 0;
    pointer-events: none;
}

/* Interactive elements catch pointer events */
.hud-interactive {
    pointer-events: auto;
}

/* Main Grid */
.studio-main-grid {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

/* Mode-dependent visibility switches */
.mode-driving .studio-only {
    display: none;
}

.mode-studio .driving-only {
    display: none;
}

/* -------------------------------------------------------------------------
   1. Floating Top Row Shell (Mode Switch, Planet Badge, Minimize)
   ------------------------------------------------------------------------- */
.shell-top-row {
    position: absolute;
    top: var(--screen-margin);
    left: var(--screen-margin);
    right: var(--screen-margin);
    height: 38px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
}

.mode-toggle-bar {
    width: 230px;
    height: 38px;
    pointer-events: auto;
    border-radius: var(--r-btn);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    padding: 2px;
    flex-direction: row;
}

.mode-toggle-item {
    flex: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0 10px;
    border-radius: var(--r-sm);
    border-width: 1px;
    border-color: transparent;
    background-color: transparent;
    color: var(--text-2);
    transition: background-color 100ms ease-out, border-color 100ms ease-out, color 100ms ease-out;
}

.mode-toggle-item:hover {
    background-color: #1E1E1E;
    color: var(--text-1);
}

.mode-toggle-item.segmented-active,
.mode-toggle-item.view-switch-active {
    background-color: #16242B;
    border-color: var(--accent);
    color: #FFFFFF;
    -unity-font-style: bold;
}

.mode-toggle-item.segmented-active .segmented-text,
.mode-toggle-item.view-switch-active .segmented-text {
    color: #FFFFFF;
    -unity-font-style: bold;
}

.mode-toggle-item.segmented-active .icon-14,
.mode-toggle-item.view-switch-active .icon-14 {
    -unity-background-image-tint-color: var(--accent);
}

.top-right-group {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    pointer-events: auto;
}

.planet-pill {
    height: 38px;
    padding: 0 14px;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    border-radius: var(--r-btn);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    transition: background-color 100ms ease-out, border-color 100ms ease-out;
}
.planet-pill:hover {
    background-color: #1E1E1E;
    border-color: #444444;
}

.planet-name-text {
    font-family: var(--font-heading);
    -unity-font: var(--font-heading);
    -unity-font-definition: var(--font-heading);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: var(--text-1);
    margin: 0;
    padding: 0;
}

.minimize-pill {
    width: 38px;
    height: 38px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-btn);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    transition: background-color 100ms ease-out, border-color 100ms ease-out;
}
.minimize-pill:hover {
    background-color: #1E1E1E;
    border-color: #444444;
}

/* Minimized Restore Button (Rectangular 6px) */
.restore-circle-btn {
    position: absolute;
    top: var(--screen-margin);
    right: var(--screen-margin);
    width: 38px;
    height: 38px;
    border-radius: var(--r-btn);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--accent);
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    transition: background-color 100ms ease-out, border-color 100ms ease-out;
}

.restore-circle-btn:hover {
    background-color: #16242B;
    border-color: var(--accent-hover);
}

.restore-circle-btn:active {
    background-color: #0E0E0E;
}

/* -------------------------------------------------------------------------
   2. Floating Bottom Controls (Camera & Driving Mode)
   ------------------------------------------------------------------------- */
.shell-bottom-left {
    position: absolute;
    bottom: var(--screen-margin);
    left: var(--screen-margin);
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    pointer-events: auto;
}

.shell-bottom-right {
    position: absolute;
    bottom: var(--screen-margin);
    right: var(--screen-margin);
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    pointer-events: auto;
}

.pill-label {
    font-family: var(--font-heading);
    -unity-font: var(--font-heading);
    -unity-font-definition: var(--font-heading);
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--text-2);
    background-color: var(--surface);
    border-radius: var(--r-sm);
    border-width: 1px;
    border-color: var(--border);
    padding: 2px 8px;
    margin-bottom: 2px;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.bottom-segmented-bar {
    width: 278px;
    height: 36px;
    border-radius: var(--r-btn);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    padding: 2px;
}

.bottom-segmented-bar .segmented-item {
    border-radius: var(--r-sm);
    font-size: 11px;
}

.bottom-segmented-bar .segmented-item.mode-pill-active,
.bottom-segmented-bar .segmented-item.segmented-active {
    background-color: #16242B;
    border-color: var(--accent);
    color: #FFFFFF;
    -unity-font-style: bold;
}

/* -------------------------------------------------------------------------
   3. Side Columns Layout (Responsive Clamped Width & Height)
   ------------------------------------------------------------------------- */
.col-left {
    position: absolute;
    left: var(--screen-margin);
    top: 66px;
    bottom: 66px;
    width: var(--side-col-width);
    max-height: 86%;
    pointer-events: auto;
    flex-direction: column;
    overflow: hidden;
}

.col-right {
    position: absolute;
    right: var(--screen-margin);
    top: 66px;
    bottom: 66px;
    width: var(--side-col-width);
    max-height: 86%;
    pointer-events: auto;
    flex-direction: column;
    overflow: hidden;
}

/* ScrollView Container for Safe Multi-Resolution Reflow */
.column-scroll-view {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.column-scroll-view > .unity-scroll-view__content-and-vertical-scroll-container {
    flex-grow: 1;
}

.column-scroll-view > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroll-view__content-viewport {
    flex-grow: 1;
}

.column-scroll-view .unity-scroller--horizontal,
.column-scroll-view .unity-scroll-view__horizontal-scroller {
    display: none;
    height: 0;
    opacity: 0;
}

.column-scroll-view .unity-scroller--vertical {
    width: 4px;
    margin-left: 2px;
}

.column-scroll-view .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
}

.column-scroll-view .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--border-hi);
    border-radius: 2px;
    width: 4px;
}

/* Column Card Spacing */
.panel-card {
    background-color: var(--surface);
    border-radius: var(--r-panel);
    padding: 8px 10px;
    border-width: 1px;
    border-color: var(--border);
    border-top-color: var(--border-hi);
    border-top-width: 1px;
    width: 100%;
    flex-shrink: 0;
    margin-bottom: var(--panel-gap);
    transition: opacity 180ms ease-out, translate 180ms ease-out;
}

.panel-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    min-height: 20px;
}

/* -------------------------------------------------------------------------
   4. Rover Deploy Card (Shared Component)
   ------------------------------------------------------------------------- */
.rover-row {
    height: 26px;
    border-radius: var(--r-inner);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px;
    margin-bottom: 3px;
    transition: background-color 100ms ease-out, border-color 100ms ease-out;
}

.rover-row:hover {
    background-color: #1F1F1F;
    border-color: #444444;
}

.rover-row-active {
    border-color: var(--accent);
    background-color: #16242B;
}

.rover-row-title {
    font-family: var(--font-heading);
    -unity-font: var(--font-heading);
    -unity-font-definition: var(--font-heading);
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--text-1);
    margin-left: 6px;
    flex-grow: 1;
}

.status-badge {
    border-radius: var(--r-sm);
    padding: 1px 6px;
    font-family: var(--font-heading);
    -unity-font: var(--font-heading);
    -unity-font-definition: var(--font-heading);
    font-size: 9px;
    -unity-font-style: bold;
    color: var(--text-3);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border);
}

.status-badge-active {
    color: var(--good);
    border-color: var(--good);
    background-color: rgba(34, 197, 94, 0.15);
}

/* -------------------------------------------------------------------------
   5. Mode A: Driving HUD Cards Specific Styles
   ------------------------------------------------------------------------- */
.stat-coords-val {
    font-family: var(--font-body);
    -unity-font: var(--font-body);
    -unity-font-definition: var(--font-body);
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--accent);
    background-color: var(--surface-2);
    border-radius: var(--r-inner);
    border-width: 1px;
    border-color: var(--border);
    padding: 4px 8px;
    margin-top: 3px;
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

/* Actuators / Wheels Container & Items */
.wheel-grid-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px;
}

.wheel-cell {
    height: 30px;
    background-color: var(--surface-2);
    border-radius: var(--r-inner);
    border-width: 1px;
    border-color: var(--border);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px;
    width: 48%;
    margin-bottom: 3px;
}

.wheel-info-col {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.wheel-name {
    font-family: var(--font-heading);
    -unity-font: var(--font-heading);
    -unity-font-definition: var(--font-heading);
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--text-2);
}

.wheel-status {
    font-family: var(--font-heading);
    -unity-font: var(--font-heading);
    -unity-font-definition: var(--font-heading);
    font-size: 9px;
    -unity-font-style: bold;
}

.tag-good { color: var(--good); }
.tag-fair { color: var(--fair); }
.tag-slip { color: var(--poor); }

.wheel-segments-row {
    flex-direction: row;
    align-items: center;
    gap: 3px;
}

.wheel-seg {
    width: 5px;
    height: 10px;
    border-radius: 1px;
    background-color: var(--good);
}

.wheel-seg.seg-active { background-color: var(--good); }
.wheel-seg.seg-fair { background-color: var(--fair); }
.wheel-seg.seg-slip { background-color: var(--poor); }
.wheel-seg.seg-inactive { background-color: rgba(255, 255, 255, 0.08); }

/* -------------------------------------------------------------------------
   6. Mode B: Full Studio Cards Specific Styles & 2D Painter
   ------------------------------------------------------------------------- */
/* Terrain Overview Canvas */
.canvas-frame {
    width: 164px;
    height: 164px;
    border-radius: var(--r-inner);
    background-color: #050505;
    border-width: 1px;
    border-color: var(--border);
    align-self: center;
    position: relative;
    overflow: hidden;
    margin-bottom: 5px;
}

.canvas-image {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
}

.canvas-grid-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 1px;
    border-color: rgba(0, 212, 255, 0.12);
    pointer-events: none;
}

/* 2D Painter Brush Cursor (Dynamic Circular Overlay) */
.painter-brush-cursor {
    position: absolute;
    border-radius: 50%;
    border-width: 1.5px;
    border-color: var(--accent);
    background-color: rgba(0, 212, 255, 0.15);
    pointer-events: none;
    display: none;
}

.radar-rover-dot {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--accent);
    border-width: 1px;
    border-color: #ffffff;
    align-items: center;
    justify-content: center;
    left: 77px;
    top: 77px;
    pointer-events: none;
}

.radar-rover-arrow {
    width: 3px;
    height: 3px;
    background-color: #ffffff;
    border-radius: 1px;
}

.radar-range-tag {
    position: absolute;
    bottom: 4px;
    right: 4px;
    background-color: rgba(10, 10, 10, 0.85);
    border-radius: var(--r-sm);
    border-width: 1px;
    border-color: var(--border);
    padding: 1px 5px;
    font-family: var(--font-heading);
    -unity-font: var(--font-heading);
    -unity-font-definition: var(--font-heading);
    font-size: 8px;
    color: var(--text-3);
    pointer-events: none;
}

/* Preset Chips (Rectangular 6px with 1px Border) */
.preset-chip-btn {
    height: 22px;
    border-radius: var(--r-btn);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border);
    font-family: var(--font-heading);
    -unity-font: var(--font-heading);
    -unity-font-definition: var(--font-heading);
    font-size: 9px;
    -unity-font-style: bold;
    color: var(--text-2);
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    transition: background-color 100ms ease-out, border-color 100ms ease-out;
}

.preset-chip-btn:hover {
    background-color: #202020;
    border-color: #444444;
}

.preset-chip-btn.preset-active,
.preset-chip-btn.preset-btn-lab-active {
    background-color: #16242B;
    border-color: var(--accent);
    color: var(--accent);
}

/* Seed Input Row & Field */
.seed-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

#FieldSeed {
    width: 120px;
    height: 24px;
    background-color: var(--surface-2);
    border-radius: var(--r-inner);
    border-width: 1px;
    border-color: var(--border);
    padding: 0;
    margin: 0;
    transition: border-color 100ms ease-out;
}

#FieldSeed .unity-base-text-field__input,
#FieldSeed .unity-integer-field__input {
    background-color: transparent;
    border-width: 0;
    color: var(--text-1);
    padding: 0 6px;
    margin: 0;
    -unity-text-align: middle-left;
    -unity-font-definition: var(--font-body);
    font-size: 11px;
}

#FieldSeed:hover {
    border-color: #444444;
}

#FieldSeed:focus {
    border-color: var(--accent);
}

/* 2D Painter Brushes (Rectangular 6px) */
.brush-segmented-bar {
    height: 26px;
    margin-bottom: 4px;
    border-radius: var(--r-btn);
}

.brush-segmented-item {
    padding: 0 4px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 3px;
    font-size: 10px;
    border-radius: var(--r-sm);
}

.brush-segmented-item.brush-btn-active,
.brush-segmented-item.segmented-active {
    background-color: #16242B;
    border-color: var(--accent);
    color: #FFFFFF;
}

.brush-segmented-item.brush-btn-active .segmented-text,
.brush-segmented-item.segmented-active .segmented-text {
    color: #FFFFFF;
    -unity-font-style: bold;
}

.brush-segmented-item.brush-btn-active .icon-12,
.brush-segmented-item.segmented-active .icon-12 {
    -unity-background-image-tint-color: var(--accent);
}

.history-tag {
    font-family: var(--font-heading);
    -unity-font: var(--font-heading);
    -unity-font-definition: var(--font-heading);
    font-size: 9px;
    color: var(--text-3);
    padding: 0 4px;
}

/* Slider Row & Labels */
.slider-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 20px;
    margin-bottom: 2px;
}

.custom-slider {
    flex-grow: 1;
    margin: 0 4px;
    padding: 0;
    height: 14px;
}

.unity-slider.custom-slider > .unity-slider__input {
    margin: 0;
    padding: 0;
    height: 14px;
}

.unity-slider.custom-slider .unity-slider__drag-container {
    height: 14px;
    justify-content: center;
}

.unity-slider.custom-slider .unity-slider__dragger {
    width: 8px;
    height: 12px;
    border-radius: 2px;
    margin-top: -4px;
}

.slider-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0px;
}

.slider-label {
    font-family: var(--font-heading);
    -unity-font: var(--font-heading);
    -unity-font-definition: var(--font-heading);
    font-size: 9px;
    -unity-font-style: bold;
    color: var(--text-2);
    text-transform: uppercase;
    width: 76px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.slider-val-label {
    font-family: var(--font-body);
    -unity-font: var(--font-body);
    -unity-font-definition: var(--font-body);
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--text-1);
    width: 42px;
    -unity-text-align: middle-right;
    margin: 0;
    padding: 0;
}

/* Material Chips */
.material-chip-btn {
    height: 22px;
    border-radius: var(--r-btn);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border);
    flex-direction: row;
    align-items: center;
    padding: 0 6px;
    margin: 0;
    transition: background-color 100ms ease-out, border-color 100ms ease-out;
}

.material-chip-btn:hover {
    background-color: #202020;
    border-color: #444444;
}

.material-chip-btn.material-btn-active {
    background-color: #16242B;
    border-color: var(--accent);
}

.material-chip-label {
    font-family: var(--font-heading);
    -unity-font: var(--font-heading);
    -unity-font-definition: var(--font-heading);
    font-size: 9px;
    -unity-font-style: bold;
    color: var(--text-2);
    overflow: hidden;
    text-overflow: ellipsis;
}

.material-chip-btn.material-btn-active .material-chip-label {
    color: var(--text-1);
}

/* Curve Bar */
.curve-segmented-bar {
    height: 22px;
    margin-top: 0;
    border-radius: var(--r-btn);
}

.curve-segmented-bar .segmented-item.curve-btn-active,
.curve-segmented-bar .segmented-item.segmented-active {
    background-color: #16242B;
    border-color: var(--accent);
    color: #FFFFFF;
    -unity-font-style: bold;
}

/* -------------------------------------------------------------------------
   7. Placement Mode Banner (Rectangular 8px)
   ------------------------------------------------------------------------- */
.placement-banner {
    position: absolute;
    top: 16px;
    align-self: center;
    height: 40px;
    border-radius: var(--r-panel);
    background-color: #0E0E0E;
    border-width: 1px;
    border-color: var(--accent);
    padding: 0 14px;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    pointer-events: auto;
    z-index: 100;
}

.placement-banner-text {
    font-family: var(--font-body);
    -unity-font: var(--font-body);
    -unity-font-definition: var(--font-body);
    font-size: 11px;
    color: var(--text-1);
    -unity-font-style: bold;
}

.placement-banner-btn {
    height: 26px;
    padding: 0 10px;
    border-radius: var(--r-btn);
}

/* -------------------------------------------------------------------------
   8. Responsive Compact View Overrides (for heights < 800px or widths < 1400px)
   ------------------------------------------------------------------------- */
.compact-view .shell-top-row {
    top: 8px;
    height: 32px;
}
.compact-view .mode-toggle-bar,
.compact-view .planet-pill,
.compact-view .minimize-pill {
    height: 32px;
}
.compact-view .col-left,
.compact-view .col-right {
    top: 48px;
    bottom: 48px;
    width: 280px;
}
.compact-view .panel-card {
    padding: 6px 8px;
    margin-bottom: 4px;
}
.compact-view .metric-value {
    font-size: 16px;
}
.compact-view .canvas-frame {
    width: 136px;
    height: 136px;
}
.compact-view .shell-bottom-left,
.compact-view .shell-bottom-right {
    bottom: 8px;
}
.compact-view .bottom-segmented-bar {
    height: 32px;
    width: 240px;
}

/* -------------------------------------------------------------------------
   9. Utility Helpers
   ------------------------------------------------------------------------- */
.flex-row { flex-direction: row; }
.flex-1 { flex-grow: 1; }
.align-center { align-items: center; }
.justify-between { justify-content: space-between; }
.gap-4 { gap: 4px; }
.gap-6 { gap: 6px; }
.gap-8 { gap: 8px; }
.mt-2 { margin-top: 2px; }
