:root {
    /* -------------------------------------------------------------
       JARVIS / Iron Man HUD Design System Tokens
       Copied directly from reference commits:
       bee59b20, 504175ac, 86e3aca8, a182f708, df6e8778, 8a181c7f
       - Translucent Holographic Cyber-Glass (see terrain & rovers through UI)
       - Iconic Arc Reactor Cyan (#00E5FF) and Tactical Amber/Emerald Accents
       - Peripheral Head-Mounted Visor framing with high readability
       - Unobstructed central 3D gameplay view
       ------------------------------------------------------------- */
    /* Semi-transparent deep cyber-glass: enables seeing the 3D game view through panels */
    --surface: #04122273;
    --surface-2: #081C3485;
    --surface-3: #0C26449E;
    --scrim: #020A1459;

    /* Luminous Arc Cyan Wireframes */
    --border: #00E5FF61;
    --border-hi: #00F5FFD9;
    --border-subtle: #00E5FF2E;

    /* Jarvis Arc Reactor Cyan Accent */
    --accent: #00E5FF;
    --accent-hover: #38E1FF;
    --accent-glow: #00E5FF52;
    --accent-dim: #00E5FF29;

    /* Semantic Buttons (Holographic Glass Fills) */
    --primary-bg: #00E5FF38;
    --primary-border: #00E5FF;
    --primary-text: #FFFFFF;
    --primary-hover-bg: #00E5FF59;
    --primary-hover-border: #38E1FF;

    --secondary-bg: #061A307A;
    --secondary-border: #00E5FF66;
    --secondary-text: #E0F7FA;
    --secondary-hover-bg: #0C2A48A6;
    --secondary-hover-border: #00E5FF;

    --confirm-bg: #00E67638;
    --confirm-border: #00E676;
    --confirm-text: #B9F6CA;
    --confirm-hover-bg: #00E67659;
    --confirm-hover-border: #B9F6CA;

    --cancel-bg: #FF174438;
    --cancel-border: #FF1744;
    --cancel-text: #FF8A80;
    --cancel-hover-bg: #FF174459;
    --cancel-hover-border: #FF8A80;

    --danger-bg: #FF174447;
    --danger-border: #FF1744;
    --danger-text: #FF8A80;
    --danger-hover-bg: #FF174466;
    --danger-hover-border: #FF8A80;

    --disabled-bg: #06101A59;
    --disabled-border: #00E5FF26;
    --disabled-text: #80DEEA73;

    /* Active / Selected Item Sets */
    --active-bg: #00E5FF47;
    --active-border: #00E5FF;
    --active-text: #FFFFFF;

    /* Status Indicators */
    --good: #00E676;
    --fair: #FFB300;
    --poor: #FF1744;

    /* Typography: High-Contrast Luminous White & Cyan */
    --text-1: #FFFFFF;
    --text-2: #80DEEA;
    --text-3: #4DD0E1;
    --text-accent: #00E5FF;

    /* High-Tech Rectangular Geometry */
    --r-panel: 6px;
    --r-inner: 4px;
    --r-btn: 4px;
    --r-pill: 4px;
    --r-sm: 3px;

    /* Spacing & Sizing Tokens */
    --screen-margin: 24px;
    --panel-gap: 8px;
    --panel-pad: 8px 10px;
    --title-gap: 8px;
    --row-gap: 6px;

    --h-control: 44px;
    --h-control-sm: 36px;
    --h-tile: 36px;

    --side-col-width: 340px;

    /* Typography Fonts */
    --font-heading: url("/Assets/project/UI/fonts/Rajdhani-SemiBold.ttf");
    --font-body: url("/Assets/project/UI/fonts/Inter.ttf");
}
