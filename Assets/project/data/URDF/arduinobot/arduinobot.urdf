<?xml version="1.0"?>
<robot name="arduinobot">

  <!-- Materials -->
  <material name="grey">
    <color rgba="0.55 0.55 0.55 1"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.30 0.30 0.30 1"/>
  </material>
  <material name="blue">
    <color rgba="0.20 0.40 0.80 1"/>
  </material>
  <material name="orange">
    <color rgba="0.90 0.50 0.10 1"/>
  </material>

  <!-- ===================== LINKS ===================== -->

  <link name="world"/>

  <!-- Base / basement -->
  <link name="base_link">
    <visual>
      <origin xyz="-0.5 -0.5 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/basement.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Simple box collision instead of full mesh (avoids VHACD crash) -->
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.40 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0.05"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <!-- Rotating base plate (joint 1) -->
  <link name="base_plate">
    <visual>
      <origin xyz="-0.39 -0.39 -0.56" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/base_plate.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.25 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.008"/>
    </inertial>
  </link>

  <!-- Servo plate -->
  <link name="servo_plate">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/servo_plate.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Round plate -->
  <link name="round_plate">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/round_plate.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0008"/>
    </inertial>
  </link>

  <!-- Main link -->
  <link name="link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/link.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.16"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0.08"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Triangular link -->
  <link name="triangular_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/triangular_link.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.04 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <!-- Horizontal arm -->
  <link name="horizontal_arm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/horizontal_arm.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0.09 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.04 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <origin xyz="0.09 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <!-- Vertical drive arm -->
  <link name="vertical_drive_arm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/vertical_drive_arm.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.14"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <origin xyz="0 0 0.07"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Forward drive arm -->
  <link name="forward_drive_arm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/forward_drive_arm.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0.08 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.04 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.45"/>
      <origin xyz="0.08 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <!-- Plate (wrist) -->
  <link name="plate">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/plate.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Claw support -->
  <link name="claw_support">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/claw_support.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.06 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <!-- Left finger -->
  <link name="left_finger">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/left_finger.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0.015 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.02 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0.015 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- Right finger -->
  <link name="right_finger">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/right_finger.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 -0.015 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.02 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 -0.015 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- ===================== JOINTS ===================== -->

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Joint 1 – base yaw -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="base_plate"/>
    <origin xyz="0 0 0.307" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="30" velocity="10"/>
  </joint>

  <!-- Joint 2 -->
  <joint name="joint_2" type="revolute">
    <parent link="base_plate"/>
    <child link="servo_plate"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="30" velocity="10"/>
  </joint>

  <!-- Joint 3 -->
  <joint name="joint_3" type="revolute">
    <parent link="servo_plate"/>
    <child link="round_plate"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="25" velocity="8"/>
  </joint>

  <!-- Joint 4 -->
  <joint name="joint_4" type="revolute">
    <parent link="round_plate"/>
    <child link="link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="25" velocity="8"/>
  </joint>

  <!-- Joint 5 -->
  <joint name="joint_5" type="revolute">
    <parent link="link"/>
    <child link="triangular_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.8" upper="1.8" effort="20" velocity="8"/>
  </joint>

  <!-- Joint 6 -->
  <joint name="joint_6" type="revolute">
    <parent link="triangular_link"/>
    <child link="horizontal_arm"/>
    <origin xyz="0.05 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="6"/>
  </joint>

  <!-- Joint 7 -->
  <joint name="joint_7" type="revolute">
    <parent link="horizontal_arm"/>
    <child link="vertical_drive_arm"/>
    <origin xyz="0.18 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="15" velocity="6"/>
  </joint>

  <!-- Joint 8 -->
  <joint name="joint_8" type="revolute">
    <parent link="vertical_drive_arm"/>
    <child link="forward_drive_arm"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="15" velocity="6"/>
  </joint>

  <!-- Joint 9 – wrist -->
  <joint name="joint_9" type="revolute">
    <parent link="forward_drive_arm"/>
    <child link="plate"/>
    <origin xyz="0.15 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="10"/>
  </joint>

  <!-- Claw support (fixed) -->
  <joint name="joint_10" type="fixed">
    <parent link="plate"/>
    <child link="claw_support"/>
    <origin xyz="0.05 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Gripper fingers -->
  <joint name="left_finger_joint" type="prismatic">
    <parent link="claw_support"/>
    <child link="left_finger"/>
    <origin xyz="0 0.03 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.04" effort="5" velocity="0.5"/>
  </joint>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="claw_support"/>
    <child link="right_finger"/>
    <origin xyz="0 -0.03 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.04" effort="5" velocity="0.5"/>
  </joint>

</robot>
