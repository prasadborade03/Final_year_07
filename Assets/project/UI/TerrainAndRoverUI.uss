/* =========================================================================
   TerrainAndRoverUI.uss - VR Rover Digital Twin Studio UI Stylesheet
   Pure Black Technical Theme · Strict Rectangular Language (8px panels, 6px controls)
   Multi-resolution responsive layout & 2D heightmap painter support
   ========================================================================= */

/* -------------------------------------------------------------------------
   0. Root Container & Viewport Pass-through
   ------------------------------------------------------------------------- */
.studio-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: transparent;
    pointer-events: none;
    overflow: hidden;
}

/* In Driving HUD Mode, background is completely clear */
.hud-mode-root {
    background-color: transparent;
    border-width: 0;
    pointer-events: none;
}

/* Interactive elements catch pointer events */
.hud-interactive {
    pointer-events: auto;
}

/* Main Grid */
.studio-main-grid {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

/* Mode-dependent visibility switches */
.mode-driving .studio-only {
    display: none;
}

.mode-studio .driving-only {
    display: none;
}

/* -------------------------------------------------------------------------
   1. Floating Top Row Shell (Mode Switch, Planet Badge, Minimize)
   ------------------------------------------------------------------------- */
.shell-top-row {
    position: absolute;
    top: var(--screen-margin);
    left: var(--screen-margin);
    right: var(--screen-margin);
    height: 38px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
}

.mode-toggle-bar {
    width: 230px;
    height: 38px;
    pointer-events: auto;
    border-radius: var(--r-btn);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    padding: 2px;
    flex-direction: row;
}

.mode-toggle-item {
    flex: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0 10px;
    border-radius: var(--r-sm);
    border-width: 1px;
    border-color: transparent;
    background-color: transparent;
    color: var(--text-2);
    transition: background-color 100ms ease-out, border-color 100ms ease-out, color 100ms ease-out;
}

.mode-toggle-item:hover {
    background-color: #142033;
    color: var(--text-1);
}

.mode-toggle-item.segmented-active,
.mode-toggle-item.view-switch-active {
    background-color: var(--active-bg);
    border-color: var(--accent);
    color: #FFFFFF;
    -unity-font-style: bold;
}

.mode-toggle-item.segmented-active .segmented-text,
.mode-toggle-item.view-switch-active .segmented-text {
    color: #FFFFFF;
    -unity-font-style: bold;
}

.mode-toggle-item.segmented-active .icon-14,
.mode-toggle-item.view-switch-active .icon-14 {
    -unity-background-image-tint-color: var(--accent);
}

.top-right-group {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    pointer-events: auto;
}

.planet-pill {
    height: 38px;
    padding: 0 14px;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    border-radius: var(--r-btn);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    transition: background-color 100ms ease-out, border-color 100ms ease-out;
}
.planet-pill:hover {
    background-color: #142033;
    border-color: var(--border-hi);
}

.planet-name-text {
    -unity-font: var(--font-heading);
    /* -unity-font-definition disabled for TTF */
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: var(--text-1);
    margin: 0;
    padding: 0;
}

.minimize-pill {
    width: 38px;
    height: 38px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-btn);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    transition: background-color 100ms ease-out, border-color 100ms ease-out;
}
.minimize-pill:hover {
    background-color: #142033;
    border-color: var(--border-hi);
}

/* Minimized Restore Button (Rectangular 6px) */
.restore-circle-btn {
    position: absolute;
    top: var(--screen-margin);
    right: var(--screen-margin);
    width: 38px;
    height: 38px;
    border-radius: var(--r-btn);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--accent);
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    transition: background-color 100ms ease-out, border-color 100ms ease-out;
}

.restore-circle-btn:hover {
    background-color: #142033;
    border-color: var(--accent-hover);
}

.restore-circle-btn:active {
    background-color: #0A111C;
}

/* -------------------------------------------------------------------------
   2. Floating Bottom Controls: Dual Dedicated Interactive Boxes
   ------------------------------------------------------------------------- */
.shell-bottom-left {
    position: absolute;
    bottom: 22px;
    left: 28px;
    padding: 8px 12px;
    background-color: var(--surface);
    border-radius: var(--r-panel);
    border-width: 1px;
    border-color: var(--border);
    border-top-width: 2px;
    border-top-color: var(--accent);
    border-left-width: 2px;
    border-left-color: #00E5FFA6;
    pointer-events: auto;
    gap: 6px;
    flex-direction: column;
    align-items: flex-start;
}

.shell-bottom-right {
    position: absolute;
    bottom: 22px;
    right: 28px;
    padding: 8px 12px;
    background-color: var(--surface);
    border-radius: var(--r-panel);
    border-width: 1px;
    border-color: var(--border);
    border-top-width: 2px;
    border-top-color: var(--accent);
    border-left-width: 2px;
    border-left-color: #00E5FFA6;
    pointer-events: auto;
    gap: 6px;
    flex-direction: column;
    align-items: flex-end;
}

.box-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 2px;
}

.box-title {
    color: #00E5FF;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.box-subtitle {
    color: #80DEEA;
    font-size: 9px;
    letter-spacing: 0.5px;
}

.box-live-speed {
    color: #00FF88;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.box-footer-hint {
    color: #80DEEA;
    font-size: 9px;
    letter-spacing: 0.5px;
    margin-top: 2px;
}

.pill-label {
    -unity-font: var(--font-heading);
    /* -unity-font-definition disabled for TTF */
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--text-2);
    background-color: var(--surface);
    border-radius: var(--r-sm);
    border-width: 1px;
    border-color: var(--border);
    padding: 3px 10px;
    margin-bottom: 3px;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.bottom-segmented-bar {
    width: 330px;
    height: 40px;
    border-radius: var(--r-btn);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border);
    padding: 2px;
}

.bottom-segmented-bar .segmented-item {
    border-radius: var(--r-sm);
    font-size: 15px;
}

.bottom-segmented-bar .segmented-item.mode-pill-active,
.bottom-segmented-bar .segmented-item.segmented-active {
    background-color: var(--active-bg);
    border-color: var(--accent);
    color: #FFFFFF;
    -unity-font-style: bold;
}

/* -------------------------------------------------------------------------
   3. Side Columns Layout (Responsive Clamped Width & Height)
   ------------------------------------------------------------------------- */
.col-left {
    position: absolute;
    left: var(--screen-margin);
    top: 66px;
    bottom: 66px;
    width: var(--side-col-width);
    max-height: 86%;
    pointer-events: auto;
    flex-direction: column;
    overflow: hidden;
}

.col-right {
    position: absolute;
    right: var(--screen-margin);
    top: 66px;
    bottom: 66px;
    width: var(--side-col-width);
    max-height: 86%;
    pointer-events: auto;
    flex-direction: column;
    overflow: hidden;
}

/* ScrollView Container for Safe Multi-Resolution Reflow */
.column-scroll-view {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.column-scroll-view > .unity-scroll-view__content-and-vertical-scroll-container {
    flex-grow: 1;
}

.column-scroll-view > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroll-view__content-viewport {
    flex-grow: 1;
}

.column-scroll-view .unity-scroller--horizontal,
.column-scroll-view .unity-scroll-view__horizontal-scroller {
    display: none;
    height: 0;
    opacity: 0;
}

.column-scroll-view .unity-scroller--vertical {
    width: 4px;
    margin-left: 2px;
}

.column-scroll-view .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
}

.column-scroll-view .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--border-hi);
    border-radius: 2px;
    width: 4px;
}

/* Column Card Spacing */
.panel-card {
    background-color: var(--surface);
    border-radius: var(--r-panel);
    padding: 8px 10px;
    border-width: 1px;
    border-color: var(--border);
    border-top-color: var(--border-hi);
    border-top-width: 2px;
    border-left-color: #00E5FFA6;
    border-left-width: 2px;
    width: 100%;
    flex-shrink: 0;
    margin-bottom: var(--panel-gap);
    transition: opacity 180ms ease-out, translate 180ms ease-out, border-color 150ms ease-out;
}

.panel-card:hover {
    border-color: #00E5FFA6;
    border-top-color: var(--accent-hover);
}

.panel-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    min-height: 20px;
}

/* -------------------------------------------------------------------------
   4. Rover Deploy Card (Shared Component)
   ------------------------------------------------------------------------- */
.rover-row {
    height: 36px;
    border-radius: var(--r-inner);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 10px;
    margin-bottom: 4px;
    transition: background-color 100ms ease-out, border-color 100ms ease-out;
}

.rover-row:hover {
    background-color: #142033;
    border-color: var(--border-hi);
}

.rover-row-active {
    border-color: var(--accent);
    background-color: var(--active-bg);
}

.rover-row-title {
    -unity-font: var(--font-heading);
    /* -unity-font-definition disabled for TTF */
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--text-1);
    margin-left: 8px;
    flex-grow: 1;
}

.status-badge {
    border-radius: var(--r-sm);
    padding: 2px 8px;
    -unity-font: var(--font-heading);
    /* -unity-font-definition disabled for TTF */
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text-3);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border);
}

.status-badge-active {
    color: var(--good);
    border-color: var(--good);
    background-color: #00E67633;
}

/* -------------------------------------------------------------------------
   5. Mode A: Driving HUD Cards Specific Styles
   ------------------------------------------------------------------------- */
.stat-coords-val {
    -unity-font: var(--font-body);
    /* -unity-font-definition disabled for TTF */
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--accent);
    background-color: var(--surface-2);
    border-radius: var(--r-inner);
    border-width: 1px;
    border-color: var(--border);
    padding: 6px 10px;
    margin-top: 4px;
    margin-bottom: 5px;
    -unity-text-align: middle-center;
}

/* Actuators / Wheels Container & Items */
.wheel-grid-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px;
}

.wheel-cell {
    height: 36px;
    background-color: var(--surface-2);
    border-radius: var(--r-inner);
    border-width: 1px;
    border-color: var(--border);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px;
    width: 48%;
    margin-bottom: 4px;
}

.wheel-info-col {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.wheel-name {
    -unity-font: var(--font-heading);
    /* -unity-font-definition disabled for TTF */
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--text-2);
}

.wheel-status {
    -unity-font: var(--font-heading);
    /* -unity-font-definition disabled for TTF */
    font-size: 14px;
    -unity-font-style: bold;
}

.tag-good { color: var(--good); }
.tag-fair { color: var(--fair); }
.tag-slip { color: var(--poor); }

.wheel-segments-row {
    flex-direction: row;
    align-items: center;
    gap: 3px;
}

.wheel-seg {
    width: 6px;
    height: 14px;
    border-radius: 2px;
    background-color: var(--good);
}

.wheel-seg.seg-active { background-color: var(--good); }
.wheel-seg.seg-fair { background-color: var(--fair); }
.wheel-seg.seg-slip { background-color: var(--poor); }
.wheel-seg.seg-inactive { background-color: #FFFFFF14; }

/* -------------------------------------------------------------------------
   6. Mode B: Full Studio Cards Specific Styles & 2D Painter
   ------------------------------------------------------------------------- */
/* Terrain Overview Canvas */
.canvas-frame {
    width: 164px;
    height: 164px;
    border-radius: var(--r-inner);
    background-color: #050505;
    border-width: 1px;
    border-color: var(--border);
    align-self: center;
    position: relative;
    overflow: hidden;
    margin-bottom: 5px;
}

.canvas-image {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
}

.canvas-grid-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 1px;
    border-color: #00D4FF1F;
    pointer-events: none;
}

/* 2D Painter Brush Cursor (Dynamic Circular Overlay) */
.painter-brush-cursor {
    position: absolute;
    border-radius: 50%;
    border-width: 1.5px;
    border-color: var(--accent);
    background-color: #00D4FF26;
    pointer-events: none;
    display: none;
}

.radar-rover-dot {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--accent);
    border-width: 1px;
    border-color: #ffffff;
    align-items: center;
    justify-content: center;
    left: 77px;
    top: 77px;
    pointer-events: none;
}

.radar-rover-arrow {
    width: 3px;
    height: 3px;
    background-color: #ffffff;
    border-radius: 1px;
}

.radar-range-tag {
    position: absolute;
    bottom: 4px;
    right: 4px;
    background-color: #0A0A0AD9;
    border-radius: var(--r-sm);
    border-width: 1px;
    border-color: var(--border);
    padding: 2px 6px;
    -unity-font: var(--font-heading);
    /* -unity-font-definition disabled for TTF */
    font-size: 14px;
    color: var(--text-3);
    pointer-events: none;
}

/* Preset Chips (Rectangular 6px with 1px Border) */
.preset-chip-btn {
    height: 30px;
    border-radius: var(--r-btn);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border);
    -unity-font: var(--font-heading);
    /* -unity-font-definition disabled for TTF */
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--text-2);
    align-items: center;
    justify-content: center;
    padding: 0 8px;
    transition: background-color 100ms ease-out, border-color 100ms ease-out;
}

.preset-chip-btn:hover {
    background-color: #142033;
    border-color: var(--border-hi);
}

.preset-chip-btn.preset-active,
.preset-chip-btn.preset-btn-lab-active {
    background-color: var(--active-bg);
    border-color: var(--accent);
    border-width: 1px;
    color: #FFFFFF;
    -unity-font-style: bold;
}

/* Seed Input Row & Field */
.seed-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

#FieldSeed {
    width: 130px;
    height: 30px;
    background-color: var(--surface-2);
    border-radius: var(--r-inner);
    border-width: 1px;
    border-color: var(--border);
    padding: 0;
    margin: 0;
    transition: border-color 100ms ease-out;
}

#FieldSeed .unity-base-text-field__input,
#FieldSeed .unity-integer-field__input {
    background-color: transparent;
    border-width: 0;
    color: var(--text-1);
    padding: 0 8px;
    margin: 0;
    -unity-text-align: middle-left;
    /* -unity-font-definition disabled for TTF */
    font-size: 15px;
}

#FieldSeed:hover {
    border-color: var(--border-hi);
}

#FieldSeed:focus {
    border-color: var(--accent);
}

/* 2D Painter Brushes (Rectangular 6px) */
.brush-segmented-bar {
    height: 32px;
    margin-bottom: 5px;
    border-radius: var(--r-btn);
}

.brush-segmented-item {
    padding: 0 6px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 4px;
    font-size: 15px;
    border-radius: var(--r-sm);
}

.brush-segmented-item:hover {
    background-color: #142033;
    border-color: #00B4D873;
    color: var(--text-1);
}

.brush-segmented-item.brush-btn-active,
.brush-segmented-item.segmented-active {
    background-color: var(--active-bg);
    border-color: var(--accent);
    color: #FFFFFF;
}

.brush-segmented-item.brush-btn-active .segmented-text,
.brush-segmented-item.segmented-active .segmented-text {
    color: #FFFFFF;
    -unity-font-style: bold;
}

.brush-segmented-item.brush-btn-active .icon-12,
.brush-segmented-item.segmented-active .icon-12 {
    -unity-background-image-tint-color: var(--accent);
}

.history-tag {
    -unity-font: var(--font-heading);
    /* -unity-font-definition disabled for TTF */
    font-size: 14px;
    color: var(--text-3);
    padding: 0 6px;
}

/* Slider Row & Labels */
.slider-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 26px;
    margin-bottom: 3px;
}

.custom-slider {
    flex-grow: 1;
    margin: 0 6px;
    padding: 0;
    height: 18px;
}

.unity-slider.custom-slider > .unity-slider__input {
    margin: 0;
    padding: 0;
    height: 18px;
}

.unity-slider.custom-slider .unity-slider__drag-container {
    height: 18px;
    justify-content: center;
}

.unity-slider.custom-slider .unity-slider__dragger {
    width: 10px;
    height: 16px;
    border-radius: 2px;
    margin-top: -5px;
}

.slider-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1px;
}

.slider-label {
    -unity-font: var(--font-heading);
    /* -unity-font-definition disabled for TTF */
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text-2);
    text-transform: uppercase;
    width: 90px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.slider-val-label {
    -unity-font: var(--font-body);
    /* -unity-font-definition disabled for TTF */
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--text-1);
    width: 50px;
    -unity-text-align: middle-right;
    margin: 0;
    padding: 0;
}

/* Material Chips */
.material-chip-btn {
    height: 30px;
    border-radius: var(--r-btn);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border);
    flex-direction: row;
    align-items: center;
    padding: 0 8px;
    margin: 0;
    transition: background-color 100ms ease-out, border-color 100ms ease-out;
}

.material-chip-btn:hover {
    background-color: #142033;
    border-color: var(--border-hi);
}

.material-chip-btn.material-btn-active {
    background-color: var(--active-bg);
    border-color: var(--accent);
    border-width: 1px;
}

.material-chip-label {
    -unity-font: var(--font-heading);
    /* -unity-font-definition disabled for TTF */
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--text-2);
    overflow: hidden;
    text-overflow: ellipsis;
}

.material-chip-btn.material-btn-active .material-chip-label {
    color: var(--text-1);
}

/* Curve Bar */
.curve-segmented-bar {
    height: 30px;
    margin-top: 0;
    border-radius: var(--r-btn);
}

.curve-segmented-bar .segmented-item.curve-btn-active,
.curve-segmented-bar .segmented-item.segmented-active {
    background-color: var(--active-bg);
    border-color: var(--accent);
    color: #FFFFFF;
    -unity-font-style: bold;
}

/* -------------------------------------------------------------------------
   7. Placement Mode Banner (Rectangular 8px)
   ------------------------------------------------------------------------- */
.placement-banner {
    position: absolute;
    top: 16px;
    align-self: center;
    height: 48px;
    border-radius: var(--r-panel);
    background-color: #0E0E0E;
    border-width: 1px;
    border-color: var(--accent);
    padding: 0 16px;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    pointer-events: auto;
    z-index: 100;
}

.placement-banner-text {
    -unity-font: var(--font-body);
    /* -unity-font-definition disabled for TTF */
    font-size: 18px;
    color: var(--text-1);
    -unity-font-style: bold;
}

.placement-banner-btn {
    height: 34px;
    padding: 0 12px;
    border-radius: var(--r-btn);
}

/* -------------------------------------------------------------------------
   8. Responsive Compact View Overrides (for heights < 800px or widths < 1400px)
   ------------------------------------------------------------------------- */
.compact-view .shell-top-row {
    top: 8px;
    height: 38px;
}
.compact-view .mode-toggle-bar,
.compact-view .planet-pill,
.compact-view .minimize-pill {
    height: 38px;
}
.compact-view .col-left,
.compact-view .col-right {
    top: 52px;
    bottom: 52px;
    width: 330px;
}
.compact-view .panel-card {
    padding: 8px 10px;
    margin-bottom: 6px;
}
.compact-view .metric-value {
    font-size: 22px;
}
.compact-view .canvas-frame {
    width: 144px;
    height: 144px;
}
.compact-view .shell-bottom-left,
.compact-view .shell-bottom-right {
    bottom: 8px;
}
.compact-view .bottom-segmented-bar {
    height: 38px;
    width: 280px;
}

/* -------------------------------------------------------------------------
   Desktop Flat Mode Responsive Overrides (Tight & Non-Obtrusive 3D View)
   ------------------------------------------------------------------------- */
.mode-flat .col-left,
.mode-flat .col-right {
    width: 290px;
    top: 56px;
    bottom: 56px;
}

.mode-flat .panel-card {
    padding: 8px 10px;
    margin-bottom: 6px;
}

.mode-flat .metric-value {
    font-size: 20px;
}

.mode-flat .guided-flow-container {
    width: 680px;
    top: 60px;
}

/* -------------------------------------------------------------------------
   9. Utility Helpers
   ------------------------------------------------------------------------- */
.flex-row { flex-direction: row; }
.flex-1 { flex-grow: 1; }
.align-center { align-items: center; }
.justify-between { justify-content: space-between; }
.gap-4 { gap: 4px; }
.gap-6 { gap: 6px; }
.gap-8 { gap: 8px; }
.mt-2 { margin-top: 2px; }
.mt-4 { margin-top: 4px; }
.mt-6 { margin-top: 6px; }
.mb-2 { margin-bottom: 2px; }
.mb-4 { margin-bottom: 4px; }
.mb-6 { margin-bottom: 6px; }
.mb-8 { margin-bottom: 8px; }

/* -------------------------------------------------------------------------
   10. 7-Step Guided Workflow Banner & Main Menu Button Styles
   ------------------------------------------------------------------------- */
.main-menu-pill {
    height: 38px;
    padding: 0 14px;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    border-radius: var(--r-btn);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    transition: background-color 100ms ease-out, border-color 100ms ease-out;
}

.main-menu-pill:hover {
    background-color: #1E1E1E;
    border-color: var(--accent);
}

.workflow-step-banner {
    position: absolute;
    top: 56px;
    align-self: center;
    width: auto;
    min-width: 760px;
    max-width: 95%;
    background-color: #0E121CF0;
    border-width: 1px;
    border-color: #1F2D44;
    border-radius: 8px;
    padding: 8px 16px;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    z-index: 90;
    pointer-events: auto;
}

.workflow-step-pills {
    flex-direction: row;
    gap: 6px;
    align-items: center;
    justify-content: center;
}

.step-pill {
    font-size: 11px;
    -unity-font-style: bold;
    color: #64748B;
    background-color: #FFFFFF0A;
    border-width: 1px;
    border-color: #FFFFFF14;
    border-radius: 4px;
    padding: 2px 7px;
    letter-spacing: 0.5px;
}

.step-pill.step-pill-done {
    color: #34D399;
    border-color: #34D39959;
    background-color: #34D3991F;
}

.step-pill.step-pill-active {
    color: #00D4FF;
    border-color: #00D4FF;
    background-color: #00D4FF33;
    -unity-font-style: bold;
}

.workflow-guide-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 16px;
}

.workflow-guide-text {
    font-size: 12px;
    color: #E2E8F0;
    -unity-font-style: bold;
    flex: 1;
}

.workflow-actions-row {
    flex-direction: row;
    gap: 8px;
}

.workflow-action-btn {
    height: 28px;
    padding: 0 10px;
    border-radius: 4px;
    font-size: 11px;
    background-color: #1E293B;
    border-color: #334155;
    border-width: 1px;
}

.workflow-action-btn:hover {
    background-color: #334155;
    border-color: #00D4FF;
}

/* =========================================================================
   Guided Simulation Flow & Confirmation Modal Styles
   ========================================================================= */

.guided-flow-container {
    position: absolute;
    top: 76px;
    bottom: 24px;
    left: 50%;
    translate: -50% 0;
    width: 760px;
    max-width: 95%;
    align-items: center;
    justify-content: flex-start;
    pointer-events: auto;
}

.flow-panel {
    width: 100%;
    max-height: 100%;
    background-color: var(--surface);
    border-radius: var(--r-panel);
    border-width: 1px;
    border-color: var(--border);
    border-top-color: var(--border-hi);
    border-top-width: 2px;
    border-left-color: #00E5FFA6;
    border-left-width: 2px;
    padding: 18px 22px;
    flex-direction: column;
}

.flow-scroll-view {
    flex-grow: 1;
    margin-right: -8px;
    padding-right: 8px;
}

.flow-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
    padding-bottom: 10px;
}

.flow-title {
    -unity-font: var(--font-heading);
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: var(--text-1);
    text-transform: uppercase;
}

.flow-step-tag {
    -unity-font: var(--font-heading);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--accent);
    background-color: var(--primary-bg);
    border-width: 1px;
    border-color: var(--accent);
    border-radius: var(--r-sm);
    padding: 2px 8px;
}

.flow-section-label {
    -unity-font: var(--font-heading);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--text-2);
    text-transform: uppercase;
    margin-top: 10px;
    margin-bottom: 6px;
}

.planet-grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
}

.planet-card {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 120px;
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border);
    border-left-width: 2px;
    border-left-color: #00E5FF4D;
    border-radius: var(--r-btn);
    padding: 10px 12px;
    flex-direction: column;
    align-items: flex-start;
    transition: background-color 120ms ease-out, border-color 120ms ease-out;
}

.planet-card:hover {
    background-color: #0C2A48A6;
    border-color: var(--border-hi);
    border-left-color: var(--accent);
}

.planet-card-active {
    background-color: var(--active-bg);
    border-color: var(--accent);
    border-left-width: 3px;
    border-left-color: var(--accent);
}

.planet-card-title {
    -unity-font: var(--font-heading);
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--text-1);
    letter-spacing: 1px;
}

.planet-card-spec {
    -unity-font: var(--font-body);
    font-size: 11px;
    color: var(--text-3);
    margin-top: 2px;
}

.flow-source-bar {
    margin-bottom: 10px;
}

.flow-actions-row {
    flex-direction: row;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 16px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: var(--border);
}

.summary-grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
    background-color: var(--surface-2);
    border-radius: var(--r-inner);
    border-width: 1px;
    border-color: var(--border);
    padding: 14px;
    margin-bottom: 12px;
}

.summary-cell {
    width: 48%;
    flex-direction: column;
    margin-bottom: 6px;
}

.summary-label {
    -unity-font: var(--font-heading);
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--text-3);
    letter-spacing: 1px;
    text-transform: uppercase;
}

.summary-val {
    -unity-font: var(--font-body);
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--accent);
    margin-top: 2px;
}

/* Confirmation Modal Overlay */
.modal-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: var(--scrim);
    align-items: center;
    justify-content: center;
    pointer-events: auto;
}

.modal-card {
    width: 480px;
    max-width: 90%;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-top-color: var(--border-hi);
    border-top-width: 2px;
    border-left-color: #00E5FFA6;
    border-left-width: 2px;
    border-radius: var(--r-panel);
    padding: 24px;
    flex-direction: column;
}

.modal-title {
    -unity-font: var(--font-heading);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--text-1);
    margin-bottom: 10px;
}

.modal-message {
    -unity-font: var(--font-body);
    font-size: 13px;
    color: var(--text-2);
    line-height: 18px;
    margin-bottom: 20px;
    white-space: normal;
}

.modal-actions-row {
    flex-direction: row;
    justify-content: flex-end;
    gap: 12px;
}

.modal-btn {
    min-width: 110px;
    height: 36px;
}

/* =========================================================================
   Modern Planet Selection Modal (UI Toolkit)
   ========================================================================= */
.planet-modal-card {
    width: 840px;
    max-width: 95%;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-top-color: var(--border-hi);
    border-top-width: 2px;
    border-left-color: #00E5FFA6;
    border-left-width: 2px;
    border-radius: var(--r-panel);
    padding: 24px;
    flex-direction: column;
}

.planet-modal-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
    padding-bottom: 12px;
}

.planet-modal-header-left {
    flex-direction: column;
    flex: 1;
}

.planet-modal-subtitle {
    -unity-font: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.5px;
    margin-top: 2px;
}

.planet-modal-close-btn {
    width: 32px;
    height: 32px;
    border-radius: var(--r-btn);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border);
    color: var(--text-2);
    font-size: 14px;
    -unity-text-align: middle-center;
    transition: background-color 100ms, color 100ms;
}

.planet-modal-close-btn:hover {
    background-color: var(--surface-3);
    color: var(--text-1);
    border-color: var(--border-hi);
}

.planet-modal-body {
    flex-direction: row;
    gap: 16px;
    min-height: 290px;
}

.planet-modal-left {
    flex: 1.1;
    flex-direction: column;
}

.planet-modal-right {
    flex: 1.3;
    flex-direction: column;
}

.planet-modal-scroll {
    flex: 1;
    max-height: 260px;
}

.planet-modal-grid {
    flex-direction: column;
    gap: 8px;
    padding-right: 6px;
}

.planet-select-card {
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border);
    border-left-width: 2px;
    border-left-color: #00E5FF4D;
    border-radius: var(--r-btn);
    padding: 8px 12px;
    flex-direction: column;
    align-items: flex-start;
    transition: background-color 120ms ease-out, border-color 120ms ease-out;
}

.planet-select-card:hover {
    background-color: #0C2A48A6;
    border-color: var(--border-hi);
    border-left-color: var(--accent);
}

.planet-select-card-active {
    background-color: var(--active-bg);
    border-color: var(--accent);
    border-left-width: 3px;
    border-left-color: var(--accent);
}

.planet-select-card-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

.planet-badge-mini {
    -unity-font: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    background-color: #00E5FF1F;
    padding: 2px 6px;
    border-radius: 3px;
}

.planet-card-hdr-tag {
    -unity-font: var(--font-mono);
    font-size: 10px;
    color: #A080FF;
    margin-top: 3px;
}

.planet-card-hdr-tag-earth {
    -unity-font: var(--font-mono);
    font-size: 10px;
    color: #4DEEEA;
    margin-top: 3px;
}

.planet-inspector-card {
    flex: 1;
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--r-card);
    padding: 14px;
    flex-direction: column;
}

.planet-inspector-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.planet-inspector-title {
    -unity-font: var(--font-heading);
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text-1);
    letter-spacing: 1px;
}

.planet-inspector-desc {
    -unity-font: var(--font-body);
    font-size: 12px;
    color: var(--text-2);
    line-height: 16px;
    margin-bottom: 12px;
    white-space: normal;
}

.planet-specs-grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
}

.spec-pod {
    width: 48%;
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--r-btn);
    padding: 6px 8px;
    flex-direction: column;
}

.spec-pod-label {
    -unity-font: var(--font-mono);
    font-size: 9px;
    color: var(--text-3);
    letter-spacing: 0.5px;
    margin-bottom: 2px;
}

.spec-pod-value {
    -unity-font: var(--font-mono);
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--text-1);
}

.planet-modal-actions {
    margin-top: 16px;
    border-top-width: 1px;
    border-top-color: var(--border);
    padding-top: 12px;
}
