<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="TerrainAndRoverUI.uss" />
    <ui:VisualElement name="RootPanel" class="root-container">
        <!-- Header -->
        <ui:VisualElement class="header-container">
            <ui:VisualElement class="title-container">
                <ui:Label text="VR ROVER DIGITAL TWIN STUDIO" class="main-title" />
                <ui:Label text="Heightmap-to-Terrain Workbench &amp; Lab" class="subtitle" />
            </ui:VisualElement>
            <ui:Label name="StateBadge" text="WAITING FOR TERRAIN" class="status-badge" />
        </ui:VisualElement>

        <!-- Workbench Scroll Body -->
        <ui:ScrollView name="WorkbenchScroll" class="workbench-scroll">
            <!-- 1. Presets & Upload -->
            <ui:VisualElement class="section-card">
                <ui:VisualElement class="section-header">
                    <ui:Label text="PRESET HEIGHTMAPS &amp; FILE UPLOAD" class="section-title" />
                </ui:VisualElement>
                <ui:VisualElement class="preset-grid">
                    <ui:Button name="BtnPresetGale" text="Gale Crater (Mars)" class="preset-btn preset-btn-active" />
                    <ui:Button name="BtnPresetOlympus" text="Olympus Mons" class="preset-btn" />
                    <ui:Button name="BtnPresetShackleton" text="Shackleton (Moon)" class="preset-btn" />
                    <ui:Button name="BtnPresetValles" text="Valles Marineris" class="preset-btn" />
                    <ui:Button name="BtnPresetPolar" text="Polar Ice Cap" class="preset-btn" />
                    <ui:Button name="BtnPresetFractal" text="Procedural Fractal" class="preset-btn" />
                </ui:VisualElement>
                <ui:Button name="BtnBrowseFile" text="📁 Upload Custom PNG/JPG Heightmap..." class="upload-btn" />
            </ui:VisualElement>

            <!-- 2. Interactive 2D Heightmap Canvas Painter -->
            <ui:VisualElement class="section-card">
                <ui:VisualElement class="section-header">
                    <ui:Label text="INTERACTIVE 2D HEIGHTMAP PAINTER" class="section-title" />
                </ui:VisualElement>
                <ui:VisualElement class="canvas-wrapper">
                    <ui:Image name="HeightmapPreviewImage" class="heightmap-preview-image" />
                    <ui:Label text="Draw directly on heightmap with brush" class="canvas-hint" />
                </ui:VisualElement>
                <!-- Brush Mode Buttons -->
                <ui:VisualElement class="brush-bar">
                    <ui:Button name="BtnBrushRaise" text="▲ Raise" class="brush-btn brush-btn-active" />
                    <ui:Button name="BtnBrushLower" text="▼ Lower" class="brush-btn" />
                    <ui:Button name="BtnBrushSmooth" text="≈ Smooth" class="brush-btn" />
                    <ui:Button name="BtnBrushFlatten" text="━ Flatten" class="brush-btn" />
                </ui:VisualElement>
                <ui:Slider name="SliderBrushRadius" label="Brush Size" low-value="0.02" high-value="0.25" value="0.08" />
                <ui:Slider name="SliderBrushStrength" label="Brush Strength" low-value="0.1" high-value="1.0" value="0.4" />
            </ui:VisualElement>

            <!-- 3. Elevation & Spatial Tuning -->
            <ui:VisualElement class="section-card">
                <ui:VisualElement class="section-header">
                    <ui:Label text="ELEVATION &amp; SPATIAL TUNING" class="section-title" />
                </ui:VisualElement>

                <!-- Max Peak Height -->
                <ui:VisualElement class="slider-row">
                    <ui:VisualElement class="slider-label-row">
                        <ui:Label text="Max Peak Height (Amplitude):" class="param-name" />
                        <ui:Label name="LabelMaxHeight" text="120.0 m" class="param-val" />
                    </ui:VisualElement>
                    <ui:Slider name="SliderMaxHeight" low-value="5" high-value="500" value="120" />
                </ui:VisualElement>

                <!-- Base Floor Offset -->
                <ui:VisualElement class="slider-row">
                    <ui:VisualElement class="slider-label-row">
                        <ui:Label text="Base Elevation Floor Offset:" class="param-name" />
                        <ui:Label name="LabelBaseOffset" text="0.0 m" class="param-val" />
                    </ui:VisualElement>
                    <ui:Slider name="SliderBaseOffset" low-value="-50" high-value="50" value="0" />
                </ui:VisualElement>

                <!-- Grid Subdivisions -->
                <ui:DropdownField name="DropdownResolution" label="Grid Subdivisions" choices="33 x 33 (Low Poly),65 x 65 (Standard),129 x 129 (Balanced),257 x 257 (High Detail),513 x 513 (Very High),1025 x 1025 (Ultra Detail)" value="513 x 513 (Very High)" />

                <!-- Gaussian Blur Kernel -->
                <ui:VisualElement class="slider-row">
                    <ui:VisualElement class="slider-label-row">
                        <ui:Label text="Gaussian Blur Kernel (Anti-Staircase):" class="param-name" />
                        <ui:Label name="LabelSmoothing" text="1.0" class="param-val" />
                    </ui:VisualElement>
                    <ui:Slider name="SliderSmoothing" low-value="0" high-value="5" value="1" />
                </ui:VisualElement>

                <!-- Height Remap Curve -->
                <ui:Label text="Elevation Remapping Curve:" class="param-name" style="margin-top: 4px;" />
                <ui:VisualElement class="curve-bar">
                    <ui:Button name="BtnCurveLinear" text="Linear" class="curve-btn curve-btn-active" />
                    <ui:Button name="BtnCurveExponential" text="Exponential" class="curve-btn" />
                    <ui:Button name="BtnCurveRidge" text="Ridge Peak" class="curve-btn" />
                    <ui:Button name="BtnCurveBasin" text="Basin Invert" class="curve-btn" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 4. Surface Material Selector -->
            <ui:VisualElement class="section-card">
                <ui:VisualElement class="section-header">
                    <ui:Label text="PLANETARY SURFACE MATERIAL" class="section-title" />
                </ui:VisualElement>
                <ui:VisualElement class="material-grid">
                    <ui:Button name="BtnMatMartian" text="🔴 Martian Rust Oxide" class="material-btn material-btn-active" />
                    <ui:Button name="BtnMatLunar" text="⚪ Lunar Regolith" class="material-btn" />
                    <ui:Button name="BtnMatBasalt" text="⚫ Volcanic Basalt" class="material-btn" />
                    <ui:Button name="BtnMatIce" text="❄️ Polar Cryo-Ice" class="material-btn" />
                    <ui:Button name="BtnMatCanyon" text="🟤 Red Sandstone" class="material-btn" />
                    <ui:Button name="BtnMatWireframe" text="🟩 Topographic Grid" class="material-btn" />
                    <ui:Button name="BtnMatNormal" text="🟣 Normal Inspector" class="material-btn" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 5. Generate Action -->
            <ui:Button name="BtnGenerateTerrain" text="✨ Apply Tuning &amp; Generate 3D Terrain" class="generate-btn" />

            <!-- 6. Digital Twin Rover Deployment -->
            <ui:VisualElement name="RoverSection" class="section-card rover-container">
                <ui:VisualElement class="section-header">
                    <ui:Label text="DEPLOY DIGITAL TWIN ROVER" class="section-title" />
                </ui:VisualElement>
                <ui:Button name="BtnRoverHusky" text="Clearpath Husky A200 (4WD Tank Drive)" class="rover-btn" />
                <ui:Button name="BtnRoverM20" text="Deep Robotics M20 (Wheeled Quadruped)" class="rover-btn" />
                <ui:Button name="BtnRoverM2020" text="NASA Perseverance M2020 (Rocker-Bogie 6WD)" class="rover-btn" />
            </ui:VisualElement>
        </ui:ScrollView>

        <!-- Status & Guide Banner -->
        <ui:VisualElement class="guide-box">
            <ui:Label name="LabelGuide" text="Configure heightmap tuning &amp; click Generate to begin." class="guide-label" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
