<?xml version="1.0"?>
<!-- Simplified standalone URDF for RB-VOGUI base (expanded from Robotnik xacro)
     Mesh paths are relative to the package root (../meshes/ from this file).
     No sensors, no Gazebo plugins. Suitable for visualization / basic simulation.
-->
<robot name="rbvogui">

  <!-- ========== Materials ========== -->
  <material name="darkgrey">
    <color rgba="0.15 0.15 0.15 1"/>
  </material>
  <material name="lightred">
    <color rgba="0.9 0.2 0.2 1"/>
  </material>
  <material name="lightgreen">
    <color rgba="0.1 1.0 0.1 1"/>
  </material>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1"/>
  </material>

  <!-- ========== Base footprint ========== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0.1165" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link"/>

  <!-- ========== Chassis ========== -->
  <joint name="chassis_joint" type="fixed">
    <origin xyz="-0.012 0 0.1775" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="chassis_link"/>
  </joint>

  <link name="chassis_link">
    <inertial>
      <mass value="25.0"/>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <inertia ixx="2.5" ixy="0" ixz="0" iyy="3.5" iyz="0" izz="4.5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/rbvogui_chassis.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/rbvogui_chassis.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- ========== Battery ========== -->
  <joint name="battery_joint" type="fixed">
    <origin xyz="0.02952 0 0" rpy="0 0 0"/>
    <parent link="chassis_link"/>
    <child link="battery_link"/>
  </joint>

  <link name="battery_link">
    <inertial>
      <mass value="45.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/rbvogui_battery.stl"/>
      </geometry>
      <material name="darkgrey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/rbvogui_battery.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- ========== Logos ========== -->
  <joint name="base_logos_joint" type="fixed">
    <origin xyz="0 0 -0.1775" rpy="0 0 0"/>
    <parent link="chassis_link"/>
    <child link="base_logos_link"/>
  </joint>

  <link name="base_logos_link">
    <visual>
      <origin xyz="-0.015 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/rbvogui_base_logos.stl" scale="1.001 1.076 1.001"/>
      </geometry>
      <material name="lightred"/>
    </visual>
  </link>

  <!-- ========== LEDs ========== -->
  <joint name="leds_joint" type="fixed">
    <origin xyz="0 0 0.1025" rpy="0 0 0"/>
    <parent link="chassis_link"/>
    <child link="leds_link"/>
  </joint>

  <link name="leds_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/rbvogui_leds.stl"/>
      </geometry>
      <material name="lightgreen"/>
    </visual>
  </link>

  <!-- ========== Docking contact ========== -->
  <joint name="base_docking_joint" type="fixed">
    <origin xyz="0.5235 0 0.09265" rpy="0 0 0"/>
    <parent link="chassis_link"/>
    <child link="base_docking_contact"/>
  </joint>

  <link name="base_docking_contact">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/rbvogui_base_docking_contact.stl"/>
      </geometry>
    </visual>
  </link>

  <!-- ========== Wheels (4x steerable) ========== -->
  <!-- wheel_radius = 0.1165, offset_x = 0.368, offset_y = 0.235 -->

  <!-- Front Right -->
  <joint name="front_right_steering_joint" type="revolute">
    <origin xyz="0.368 -0.235 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_right_base_wheel"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.0" upper="3.0" effort="200" velocity="100"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <link name="front_right_base_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.14159"/>
      <geometry>
        <mesh filename="../meshes/steering_wheel/mw_frame_stl_color.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 3.14159"/>
      <geometry>
        <mesh filename="../meshes/steering_wheel/mw_frame_stl_color.dae"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.5"/>
      <origin xyz="0 0 0.0777" rpy="1.5708 1.5708 1.5708"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.017"/>
    </inertial>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="front_right_base_wheel"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.5" friction="2.0"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/rubber_wheel/rubber_wheel.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <sphere radius="0.1165"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.035" ixy="0" ixz="0" iyy="0.034" iyz="0" izz="0.035"/>
    </inertial>
  </link>

  <!-- Front Left -->
  <joint name="front_left_steering_joint" type="revolute">
    <origin xyz="0.368 0.235 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_left_base_wheel"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.0" upper="3.0" effort="200" velocity="100"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <link name="front_left_base_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/steering_wheel/mw_frame_stl_color.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/steering_wheel/mw_frame_stl_color.dae"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.5"/>
      <origin xyz="0 0 0.0777" rpy="1.5708 1.5708 0"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.017"/>
    </inertial>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="front_left_base_wheel"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.5" friction="2.0"/>
  </joint>

  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="3.14159 0 0"/>
      <geometry>
        <mesh filename="../meshes/rubber_wheel/rubber_wheel.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <sphere radius="0.1165"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.035" ixy="0" ixz="0" iyy="0.034" iyz="0" izz="0.035"/>
    </inertial>
  </link>

  <!-- Back Left -->
  <joint name="back_left_steering_joint" type="revolute">
    <origin xyz="-0.368 0.235 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="back_left_base_wheel"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.0" upper="3.0" effort="200" velocity="100"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <link name="back_left_base_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/steering_wheel/mw_frame_stl_color.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/steering_wheel/mw_frame_stl_color.dae"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.5"/>
      <origin xyz="0 0 0.0777" rpy="1.5708 1.5708 0"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.017"/>
    </inertial>
  </link>

  <joint name="back_left_wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="back_left_base_wheel"/>
    <child link="back_left_wheel"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.5" friction="2.0"/>
  </joint>

  <link name="back_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="3.14159 0 0"/>
      <geometry>
        <mesh filename="../meshes/rubber_wheel/rubber_wheel.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <sphere radius="0.1165"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.035" ixy="0" ixz="0" iyy="0.034" iyz="0" izz="0.035"/>
    </inertial>
  </link>

  <!-- Back Right -->
  <joint name="back_right_steering_joint" type="revolute">
    <origin xyz="-0.368 -0.235 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="back_right_base_wheel"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.0" upper="3.0" effort="200" velocity="100"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <link name="back_right_base_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.14159"/>
      <geometry>
        <mesh filename="../meshes/steering_wheel/mw_frame_stl_color.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 3.14159"/>
      <geometry>
        <mesh filename="../meshes/steering_wheel/mw_frame_stl_color.dae"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.5"/>
      <origin xyz="0 0 0.0777" rpy="1.5708 1.5708 1.5708"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.017"/>
    </inertial>
  </link>

  <joint name="back_right_wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="back_right_base_wheel"/>
    <child link="back_right_wheel"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.5" friction="2.0"/>
  </joint>

  <link name="back_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/rubber_wheel/rubber_wheel.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <sphere radius="0.1165"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.035" ixy="0" ixz="0" iyy="0.034" iyz="0" izz="0.035"/>
    </inertial>
  </link>

</robot>
